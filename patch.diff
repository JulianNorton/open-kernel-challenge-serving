+# See the License for the specific language governing permissions and
+# limitations under the License.
+# ==============================================================================
+"""Token-sharded pre- / post-expert projections for Muse Spark under pure tensor parallelism.
+
+The pooler ([T, 8192] -> [T, 4096]) and unpooler ([T, 4096] -> [T, 8192]) weights are replicated on every TP rank,
+so without sharding every rank multiplies all T rows. Here each rank multiplies ceil(T / TP) rows and an all-gather
+restores the full [T, N] result; for the unpooler, whose input is each rank's partial expert sum, a reduce-scatter
+both reduces the partials and hands out the rows, replacing the all-reduce. Each row goes through the same BF16
+GEMM as before; the residual stream and the norm / boundary kernels still see full rows.
+
+Enabled by --moe-proj-shard-min-tokens N (batches of at least N tokens; 0, the default, keeps the replicated path).
+``selfcheck`` runs once at load: both sharded projections against the replicated path on a test batch, with the
+verdict agreed over the TP ranks, so every rank keeps the replicated path if any rank fails. ``summary`` reports the
+outcome (the scheduler's internal state shows it).
+
+The second part is the expert step of LayerNorm SP (--enable-layernorm-sp) without an A2A dispatcher (Marlin
+experts): ``sp_gather_experts`` and its load-time ``sp_gather_selfcheck``.
+"""
+
+import logging
+
+import torch
+import torch.distributed as dist
+import torch.nn.functional as F
+
+from sglang.srt.layers import layernorm_sp
+from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+from sglang.srt.runtime_context import get_flags, get_forward, get_parallel
+
+logger = logging.getLogger(__name__)
+
+# Test batch of the load-time check: not a multiple of the TP size, so the padded last shard is exercised.
+SELFCHECK_TOKENS = 4103
+# Relative error allowed against the replicated path. Sharding changes only GEMM shapes and the reduction order of
+# the BF16 partial sums (~1e-3); a wrong row slice or a missing partial gives errors of order 1.
+SELFCHECK_TOL = 2e-2
+
+_STATE = {"status": "off", "reason": "not checked"}
+
+
+def summary() -> dict:
+    """The load-time outcome: status on / off, the reason, the check's relative error and the token threshold."""
+    return dict(_STATE)
+
+
+def shards_projections(min_tokens: int, tp_size: int, moe_tp_size: int, num_tokens: int) -> bool:
+    """Whether a batch of num_tokens runs the replicated projections token-sharded.
+
+    The decision depends only on the token count, static configuration and the agreed load-time verdict, so every
+    TP rank takes the same branch and issues the same collectives."""
+    return (
+        _STATE["status"] == "on"
+        and 0 < min_tokens <= num_tokens
+        and tp_size > 1
+        and moe_tp_size == 1
+        and not getattr(get_forward(), "sp_active", False)
+    )
+
+
+def token_sharded_proj(x: torch.Tensor, weight: torch.Tensor, *, partial: bool) -> torch.Tensor:
+    """``x @ weight.T`` for a projection replicated on every TP rank, computed on token shards.
+
+    Each rank multiplies ceil(T / TP) rows of ``x`` and an all-gather restores the [T, N] result on every rank.
+    With ``partial``, ``x`` holds this rank's partial sums and a reduce-scatter both reduces them and hands out the
+    rows, replacing the all-reduce of the unsharded path.
+    """
+    group = get_parallel().tp_group
+    num_tokens, world = x.shape[0], group.world_size
+    rows = -(-num_tokens // world)
+    if partial:
+        x = F.pad(x, (0, 0, 0, rows * world - num_tokens))
+        local = x.new_empty((rows, x.shape[1]))
+        group.reduce_scatter_tensor(local, x)
+    else:
+        start = min(group.rank_in_group * rows, num_tokens)
+        end = min(start + rows, num_tokens)
+        local = F.pad(x[start:end], (0, 0, 0, rows - (end - start)))
+    local_out = bf16_gemm_dispatch(local, weight, None)
+    out = local_out.new_empty((rows * world, local_out.shape[1]))
+    group.all_gather_into_tensor(out, local_out)
+    return out[:num_tokens]
+
+
+def _rel(a: torch.Tensor, b: torch.Tensor) -> float:
+    return float((a.float() - b.float()).norm() / b.float().norm().clamp(min=1e-12))
+
+
+@torch.no_grad()
+def selfcheck(moe_layers, min_tokens: int) -> None:
+    """Check both sharded projections of the first MoE layer against the replicated path, once at load (before CUDA
+    graphs are captured), and switch sharding on only if every TP rank passes.
+
+    Phase 1 builds the test inputs and the pooler reference with local work only; phase 2 runs the collectives (the
+    sharded pooler, the stock all-reduce + unpooler reference and the sharded unpooler). Each phase's outcome is
+    agreed over the TP group's CPU (gloo) group, and any exception counts as a failure, so a failure on one rank
+    keeps the replicated path on all of them."""
+    from sglang.srt.distributed import tensor_model_parallel_all_reduce
+
+    parallel = get_parallel()
+    if min_tokens <= 0:
+        _STATE.update(status="off", reason="option off")
+        return
+    if parallel.tp_size <= 1 or parallel.moe_tp_size != 1:
+        _STATE.update(status="off", reason="needs pure tensor parallelism")
+        return
+    moe = next((m for m in moe_layers if getattr(m, "pre_expert_proj", None) is not None
+                and getattr(m, "post_expert_proj", None) is not None), None)
+    if moe is None:
+        _STATE.update(status="off", reason="no replicated projections")
+        return
+    group = parallel.tp_group
+
+    def agree(ok: bool) -> bool:
+        flag = torch.tensor([1 if ok else 0], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group.cpu_group)
+        return bool(flag.item())
+
+    w_pre, w_post = moe.pre_expert_proj.weight, moe.post_expert_proj.weight
+    err, why = float("inf"), None
+    try:  # phase 1: local work only
+        g = torch.Generator(device=w_pre.device).manual_seed(1234)  # the same replicated input on every rank
+        x = torch.randn((SELFCHECK_TOKENS, w_pre.shape[1]), generator=g, device=w_pre.device).to(w_pre.dtype)
+        gp = torch.Generator(device=w_pre.device).manual_seed(4321 + group.rank_in_group)  # per-rank partial sums
+        p = 0.1 * torch.randn((SELFCHECK_TOKENS, w_post.shape[1]), generator=gp, device=w_post.device)
+        p = p.to(w_post.dtype)
+        ref_pre = bf16_gemm_dispatch(x, w_pre, None)
+        ok = True
+    except Exception as e:  # noqa: BLE001 - any failure keeps the replicated path
+        ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+    if agree(ok):
+        try:  # phase 2: the collectives, in the same order on every rank
+            got_pre = token_sharded_proj(x, w_pre, partial=False)
+            ref_post = bf16_gemm_dispatch(tensor_model_parallel_all_reduce(p.clone()), w_post, None)
+            got_post = token_sharded_proj(p, w_post, partial=True)
+            err = max(_rel(got_pre, ref_pre), _rel(got_post, ref_post))
+            ok = err <= SELFCHECK_TOL  # False for NaN too
+            if not ok:
+                why = f"relative error {err:.2e} above {SELFCHECK_TOL}"
+        except Exception as e:  # noqa: BLE001
+            ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+        ok = agree(ok)
+    else:
+        ok = False
+    _STATE.update(status="on" if ok else "off", reason="selfcheck passed" if ok else (why or "failed on another rank"),
+                  err=f"{err:.2e}", min_tokens=min_tokens, check_tokens=SELFCHECK_TOKENS)
+    torch.cuda.empty_cache()
+    (logger.info if ok else logger.warning)("Muse Spark token-sharded projections: %s", _STATE)
+
+
+# ---- LayerNorm SP (--enable-layernorm-sp) for experts without an A2A dispatcher (Marlin) --------------------------
+# Each rank holds its local experts, so the SP expert step gathers the token shards, runs this rank's experts over
+# every token exactly as the replicated path does, and reduce-scatters the partial sums back to token shards: the
+# replicated all-reduce split into its reduce-scatter half. ``sp_gather_selfcheck`` tests that step on the TP group at
+# load and turns SP off on every rank if any rank fails.
+
+SP_SELFCHECK_TOKENS = 1031  # not a multiple of the TP size: exercises the padded last shard
+
+_SP_STATE = {"status": "off", "reason": "not checked"}
+
+
+def sp_summary() -> dict:
+    return dict(_SP_STATE)
+
+
+def sp_status_text() -> str:
+    """The SP outcome as one value of at most 100 characters."""
+    return f"{_SP_STATE['status']} err={_SP_STATE.get('err')} {_SP_STATE['reason']}"[:100]
+
+
+def gather_reduce_scatter(fn, *shards: torch.Tensor, num_tokens: int) -> torch.Tensor:
+    """All-gather the token shards, apply ``fn`` (this rank's partial result [num_tokens, H]) and reduce-scatter it
+    back to this rank's shard, in ``layernorm_sp.sp_entry_scatter``'s layout."""
+    partial = fn(*[layernorm_sp.sp_exit_gather(s, num_tokens=num_tokens) for s in shards])
+    group = get_parallel().tp_group
+    world = group.world_size
+    if world == 1:
+        return partial
+    padded = -(-num_tokens // world) * world
+    if padded != num_tokens:
+        partial = F.pad(partial, (0, 0, 0, padded - num_tokens))
+    out = partial.new_empty((padded // world, partial.shape[1]))
+    group.reduce_scatter_tensor(out, partial.contiguous())
+    return out
+
+
+def sp_gather_experts(moe, expert_input, topk_scores, topk_ids) -> torch.Tensor:
+    """SP expert step without A2A: shards of the pooled activation (before the pre-expert norm) and top-k in, shards
+    of this rank's reduced expert output out."""
+
+    def experts(x, scores, ids):
+        if moe.nvfp4_checkpoint:
+            return moe.experts(x, scores, ids, moe.experts.post_expert_norm, pre_expert_norm=moe.pre_expert_norm)
+        if moe.pre_expert_norm is not None:
+            x = moe.pre_expert_norm(x)
+        return moe.experts(x, scores, ids, moe.experts.post_expert_norm)
+
+    return gather_reduce_scatter(experts, expert_input, topk_scores, topk_ids,
+                                 num_tokens=layernorm_sp.sp_num_tokens())
+
+
+@torch.no_grad()
+def sp_gather_selfcheck(hidden_size: int, device) -> None:
+    """``gather_reduce_scatter`` with a per-rank stand-in expert against the replicated all-reduce. Local setup and
+    the collectives are each agreed over the TP CPU group; any failure or exception turns SP off on every rank."""
+    from sglang.srt.distributed import tensor_model_parallel_all_reduce
+
+    if not layernorm_sp.layernorm_sp_enabled():
+        _SP_STATE.update(status="off", reason="option off")
+        return
+    group = get_parallel().tp_group
+    world, rank = group.world_size, group.rank_in_group
+
+    def agree(ok: bool) -> bool:
+        flag = torch.tensor([1 if ok else 0], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group.cpu_group)
+        return bool(flag.item())
+
+    n, err, why, saved = SP_SELFCHECK_TOKENS, float("inf"), None, layernorm_sp.sp_num_tokens()
+    try:  # local work only
+        g = torch.Generator(device=device).manual_seed(1234)  # the same batch on every rank
+        x = torch.randn((n, hidden_size), generator=g, device=device).to(torch.bfloat16)
+        gw = torch.Generator(device=device).manual_seed(4321 + rank)  # a different stand-in per rank
+        w = (torch.randn((hidden_size, hidden_size), generator=gw, device=device) / hidden_size**0.5).to(torch.bfloat16)
+        rows = -(-n // world)
+        shard = F.pad(x, (0, 0, 0, rows * world - n))[rank * rows:(rank + 1) * rows].contiguous()
+        xw = x @ w.t()  # every GEMM here, before any collective: a local failure cannot strand the others
+        ok = True
+    except Exception as e:  # noqa: BLE001
+        ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+    if agree(ok):
+        try:  # the collectives only, in the same order on every rank
+            ref = tensor_model_parallel_all_reduce(xw.clone())
+            gathered = []
+            # The stand-in expert records the gathered rows and returns the product computed above (no work
+            # between the gather and the reduce-scatter); the gathered rows are compared with x afterwards.
+            got = gather_reduce_scatter(lambda full: gathered.append(full) or xw, shard, num_tokens=n)
+            ref = F.pad(ref, (0, 0, 0, rows * world - n))[rank * rows:(rank + 1) * rows]
+            err = max(_rel(got, ref), _rel(gathered[0], x))
+            ok = err <= SELFCHECK_TOL  # False for NaN too
+            why = None if ok else f"relative error {err:.2e} above {SELFCHECK_TOL}"
+        except Exception as e:  # noqa: BLE001
+            ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+        ok = agree(ok)
+    else:
+        ok = False
+    layernorm_sp.set_sp_num_tokens(saved)
+    if not ok:
+        get_flags().sp.enabled = False  # agreed by every rank: the replicated path serves every batch
+    reason = "selfcheck passed" if ok else (why or "failed on another rank")
+    _SP_STATE.update(status="on" if ok else "off", reason=reason, err=f"{err:.2e}", check_tokens=n)
+    torch.cuda.empty_cache()
+    (logger.info if ok else logger.warning)("Muse Spark LayerNorm SP, experts without A2A: %s", _SP_STATE)
+
+
+# ---- DFlash drafter context projection on token shards (--draft-proj-shard-min-tokens) ---------------------------
+# The drafter projects the target's K captured layer outputs of every prompt token into its context
+# (``project_target_hidden``: fc, (K x hidden) -> hidden, then hidden_norm). fc is replicated, so every rank
+# projects every row. Above the row threshold each rank projects 1/TP of the rows and an all-gather restores them:
+# - without LayerNorm SP the taps are replicated: the worker slices this rank's rows (``dp_project``);
+# - with LayerNorm SP the taps are still token shards at the model's exit: they are projected there and the
+#   gather moves [T, hidden] rows instead of [T, K x hidden] (``dp_project_sp_exit``); the drafter then applies
+#   only hidden_norm to the projected rows.
+# Same weights and per-row arithmetic as the replicated GEMM. Checked against it at load on the TP group (any
+# failure on any rank keeps the replicated projection everywhere).
+
+DP_SELFCHECK_TOKENS = 1031
+
+_DP_STATE = {"status": "off", "reason": "not checked"}
+_DP = {"fc": None, "group": None, "min_tokens": 0, "hidden": 0}
+
+
+def dp_summary() -> dict:
+    return dict(_DP_STATE)
+
+
+def dp_status_text() -> str:
+    """The outcome as one value of at most 100 characters."""
+    s = _DP_STATE
+    return f"{s['status']} min={_DP['min_tokens']} err={s.get('err')} {s['reason']}"[:100]
+
+
+def _dp_linear(x: torch.Tensor) -> torch.Tensor:
+    y = _DP["fc"](x)
+    return y[0] if isinstance(y, tuple) else y
+
+
+def dp_active(num_tokens: int) -> bool:
+    """Whether a batch of this many prompt rows takes the sharded projection (static per row count)."""
+    return _DP["fc"] is not None and _DP["min_tokens"] > 0 and num_tokens >= _DP["min_tokens"]
+
+
+def dp_is_projected(target_hidden: torch.Tensor) -> bool:
+    """Rows that left the model already projected (the SP exit path): width hidden, not K x hidden."""
+    return _DP["fc"] is not None and target_hidden.shape[-1] == _DP["hidden"]
+
+
+def _dp_local(target_hidden: torch.Tensor) -> torch.Tensor:
+    """fc of this rank's 1/TP of the replicated rows, padded to the common shard size (local work only)."""
+    group = _DP["group"]
+    world, rank, n = group.world_size, group.rank_in_group, target_hidden.shape[0]
+    rows = -(-n // world)
+    local = target_hidden[rank * rows:min(n, (rank + 1) * rows)]
+    if local.shape[0] < rows:  # the last ranks' rows are short (or empty)
+        local = F.pad(local, (0, 0, 0, rows - local.shape[0]))
+    return _dp_linear(local).contiguous()
+
+
+def _dp_gather(part: torch.Tensor, n: int) -> torch.Tensor:
+    group = _DP["group"]
+    out = part.new_empty((part.shape[0] * group.world_size, part.shape[1]))
+    group.all_gather_into_tensor(out, part)
+    return out[:n]
+
+
+def dp_project(target_hidden: torch.Tensor) -> torch.Tensor:
+    """fc of replicated rows [N, K x hidden] on this rank's 1/TP of them, all-gathered to [N, hidden]."""
+    return _dp_gather(_dp_local(target_hidden), target_hidden.shape[0])
+
+
+def _dp_sp_gather(projected_shard: torch.Tensor, num_tokens: int) -> torch.Tensor:
+    out = layernorm_sp.sp_exit_gather(projected_shard, num_tokens=num_tokens)
+    out.draft_projected = True  # read by the logits processor's capture check
+    return out
+
+
+def dp_project_sp_exit(packed_shard: torch.Tensor, num_tokens: int) -> torch.Tensor:
+    """SP exit: fc of this rank's token shard of the packed taps, then the exit gather of the projected rows."""
+    return _dp_sp_gather(_dp_linear(packed_shard), num_tokens)
+
+
+@torch.no_grad()
+def dp_setup(draft_model, min_tokens: int, device) -> None:
+    """Enable the sharded projection for this drafter if the option is set and the check passes on every rank.
+    Called once by the DFlash worker after the drafter is loaded and before any CUDA graph is captured."""
+    _DP.update(fc=None, min_tokens=0)
+    fc = getattr(draft_model, "fc", None)
+    k = int(getattr(draft_model, "num_context_features", 0) or 0)
+    group = get_parallel().tp_group
+    if min_tokens <= 0:
+        _DP_STATE.update(status="off", reason="option off")
+        return
+    world, rank = group.world_size, group.rank_in_group
+    why, err = None, float("inf")
+    if world <= 1:
+        why = "tp size 1"
+    elif fc is None or k < 2 or not hasattr(draft_model, "hidden_norm"):
+        why = "drafter without a K >= 2 context projection"
+
+    def agree(ok: bool) -> bool:
+        flag = torch.tensor([1 if ok else 0], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group.cpu_group)
+        return bool(flag.item())
+
+    ok = agree(why is None)
+    if ok:
+        n, sp = DP_SELFCHECK_TOKENS, layernorm_sp.layernorm_sp_enabled()
+        try:  # local work only: every GEMM of the check, before any collective
+            weight = fc.weight
+            hidden, width = int(weight.shape[0]), int(weight.shape[1])
+            _DP.update(fc=fc, group=group, min_tokens=int(min_tokens), hidden=hidden)
+            g = torch.Generator(device=device).manual_seed(4321)  # the same batch on every rank
+            x = torch.randn((n, width), generator=g, device=device).to(weight.dtype)
+            ref = _dp_linear(x)
+            part = _dp_local(x)
+            if sp:  # the SP exit form, on layernorm_sp's partition (contiguous blocks, padded last block)
+                rows = -(-n // world)
+                shard = F.pad(x, (0, 0, 0, rows * world - n))[rank * rows:(rank + 1) * rows]
+                sp_part = _dp_linear(shard.contiguous())
+            ok = True
+        except Exception as e:  # noqa: BLE001
+            ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+        if agree(ok):
+            try:  # the collectives, in the same order on every rank
+                err = _rel(_dp_gather(part, n), ref)
+                if sp:
+                    err = max(err, _rel(_dp_sp_gather(sp_part, n), ref))
+                ok = err <= SELFCHECK_TOL  # False for NaN too
+                why = None if ok else f"relative error {err:.2e} above {SELFCHECK_TOL}"
+            except Exception as e:  # noqa: BLE001
+                ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+            ok = agree(ok)
+        else:
+            ok = False
+    if not ok:
+        _DP.update(fc=None, min_tokens=0)
+    reason = "selfcheck passed" if ok else (why or "failed on another rank")
+    _DP_STATE.update(status="on" if ok else "off", reason=reason, err=f"{err:.2e}", check_tokens=DP_SELFCHECK_TOKENS)
+    torch.cuda.empty_cache()
+    (logger.info if ok else logger.warning)("DFlash drafter projection on token shards: %s", _DP_STATE)
