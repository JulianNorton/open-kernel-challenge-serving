@@ -0,0 +1,962 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Muse Spark NVFP4 routed experts on the Marlin-layout decode kernel (``moe_marlin_small``), chosen per batch size.
+
+Stock SGLang serves every expert call with Marlin. With ``--muse-spark-kernel-moe-marlin-layout`` the kernel, which
+reads stock Marlin's own packed tensors (nothing is repacked, copied or re-pointed), takes the batch sizes where it is
+faster; Marlin serves every other size and every path this module does not touch.
+
+Load sequence (``setup_marlin_layout``, called once from ``MuseSparkTextForCausalLM.prepare_before_cuda_graph_capture``,
+i.e. after Marlin has prepared its tensors and before any CUDA graph is captured):
+
+1. The NVFP4 expert layers on Marlin are found; anything else keeps stock everywhere.
+2. Self-test of each kernel variant (``moe_marlin_small.VARIANTS``) against Marlin on the first such layer's real
+   weights at ``MMS_ROWS`` (and every size of a fixed table), rows alternating dense and uniform routing, then a graph
+   check (capture, replay on fresh inputs, compare with eager). Every verdict is agreed over TP ranks.
+3. Dispatch table, per size class (a class serves the batches up to its size; larger batches stay on Marlin):
+   * default: Marlin and each passing variant are timed in captured graphs with routing uniform over all experts
+     (``selftest.probe``); a class takes the fastest passing variant that is faster than Marlin on every rank
+     (agreed), else Marlin;
+   * ``--muse-spark-kernel-moe-marlin-layout-table "8:2,32:2,...,768:M"``: the table as given (variant or M), no
+     timing; only the variants it names are self-tested and graph-checked, and a class whose variant failed
+     serves Marlin.
+4. Every layer: its views and one eager call per variant used; any failure on any rank keeps Marlin everywhere.
+
+The expert call (``mms_forward``, from ``MuseSpark1xFp4Experts.forward`` before the Marlin branch) depends only on the
+row count. Readout: ``summary`` (internal state ``muse_spark_fused``; every value at most ``READOUT_MAX`` characters)
+and TELEM log lines.
+"""
+import logging
+import time
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_STATE = {}
+
+# Sizes self-tested and timed (one launch chain covers up to 768 rows); each is the upper bound of a size class.
+# What each size exercises: 1 the minimum; 8 one 8-token tile; 17 crosses the 16-token tile; 64 one 64-row weight block;
+# 255 odd; 256 the largest table class; 768 the most rows one launch chain covers.
+MMS_ROWS = (1, 8, 17, 64, 255, 256, 768)
+GRAPH_ROWS = (1, 17, 256, 768)  # sizes of the graph check
+_MMS_ROUTE = []  # [(largest M, variant or None for Marlin)], agreed over ranks
+
+
+def memory():
+    """This rank's GPU memory in MB: the caching allocator's figures and the driver's used bytes."""
+    mb = 2 ** 20
+    out = dict(alloc_mb=torch.cuda.memory_allocated() // mb, reserved_mb=torch.cuda.memory_reserved() // mb)
+    try:
+        free, total = torch.cuda.mem_get_info()
+        out["used_mb"] = (total - free) // mb
+    except Exception:
+        pass
+    return out
+
+
+def telem(event, **kv):
+    """One TELEM line in this rank's log."""
+    logger.warning("TELEM kind=mark name=%s %s", event, " ".join(f"{k}={v}" for k, v in kv.items()))
+
+
+_CALLS = {}  # (path, mode) -> [calls, smallest M, largest M]
+
+
+def count_call(path, m):
+    """Count one kernel expert call: mode "prefill_capture" (SGLang's breakable prefill-graph capture),
+    "graph_capture" (other captures) or "eager". Graph replays run no Python, so a captured shape counts once."""
+    if torch.cuda.is_current_stream_capturing():
+        try:
+            from sglang.srt.model_executor.runner_backend_utils.breakable_cuda_graph.context import (
+                is_in_breakable_cuda_graph,
+            )
+
+            mode = "prefill_capture" if is_in_breakable_cuda_graph() else "graph_capture"
+        except Exception:
+            mode = "graph_capture"
+    else:
+        mode = "eager"
+    c = _CALLS.setdefault((path, mode), [0, m, m])
+    c[0], c[1], c[2] = c[0] + 1, min(c[1], m), max(c[2], m)
+
+
+READOUT_MAX = 100  # characters per readout value (result listings cut longer setting values)
+
+
+def _clip(v):
+    s = str(v)
+    return s if len(s) <= READOUT_MAX else s[:READOUT_MAX - 1] + "~"
+
+
+def _num(v, fmt=".3f"):
+    return "-" if v is None else format(v, fmt)
+
+
+def _ms(v):
+    return f"{v:.3f}" if v < 10 else f"{v:.2f}" if v < 100 else f"{v:.0f}"
+
+
+def _fmt_ms(d):
+    return "/".join(f"{m}:{v:.3f}" for m, v in sorted(d.items())) or "none"
+
+
+def mms_readout(mm):
+    """The kernel's record: ``mms_ratio`` (the best passing variant's time / Marlin's per size, and the dispatch per
+    size: the variant used, or M for Marlin; with a fixed table only the dispatch), ``mms_status`` (status, layers,
+    the variants that passed, Marlin's own batch error, scratch, setup time) and one ``mms_v<variant>`` per variant
+    (self-test verdict, error against Marlin, graph replay error, ms per size)."""
+    out, sizes, m = {}, mm.get("sizes", ()), mm.get("marlin", {})
+    k, use, tests = mm.get("kernel", {}), mm.get("use", {}), mm.get("tests", {})
+    letters = "".join(str(use[s]) if use.get(s) is not None else "M" for s in sizes)
+    if sizes and k:
+        best = {s: min((k[v][s] for v in k if k[v].get(s)), default=None) for s in sizes}
+        out["mms_ratio"] = ("/".join(_num(best[s] / m[s], ".2f") if best[s] and m.get(s) else "-" for s in sizes) +
+                            " k/m@" + "/".join(map(str, sizes)) + " use=" + letters)
+    elif sizes and mm.get("table"):
+        out["mms_ratio"] = "table @" + "/".join(map(str, sizes)) + " use=" + letters
+    for var, (ok, err, gok, gerr) in tests.items():
+        v = f"{'ok' if ok and gok else 'FAIL'} {err:.1e}" + (f" g{gerr:.0e}" if gerr is not None else "")
+        if var in k:
+            v += " | " + "/".join(_ms(k[var][s]) if k[var].get(s) else "-" for s in sizes) + " ms"
+        out[f"mms_v{var}"] = v
+    v = f"{mm.get('status', 'off')} {mm.get('layers', 0)}/{mm.get('of', 0)}"
+    if tests:
+        v += " pass=" + ("".join(str(var) for var, t in tests.items() if t[0] and t[2]) or "-")
+    if "ref" in mm:
+        v += f" ref {mm['ref']:.0e}"
+    v += f" @{sizes[0]}-{sizes[-1]} {mm.get('scratch_mb', 0)}MiB {mm.get('time_s', 0.0):.1f}s" if sizes else ""
+    out["mms_status"] = v + (f" reason={mm['reason']}" if mm.get("reason") else "")
+    return out
+
+
+def large_readout(rec):
+    """The large-batch kernel's measurement as one value: ``ok err=<vs Marlin> g=<graph replay> U <k/m at
+    LARGE_ROWS> C <k/m at LARGE_ROWS> <setup s>`` (U uniform, C concentrated routing), or ``off <reason>``."""
+    if rec.get("engage"):  # --muse-spark-kernel-moe-large: variant in use, each candidate's verdict
+        verdicts = " " + " ".join(f"v{v}:{r}" for v, r in rec.get("verdicts", {}).items()) if rec.get("verdicts") else ""
+        if rec.get("status") != "on":
+            return f"off{verdicts} min={rec.get('min_rows')} {rec.get('reason', '-')}"
+        km = f" k/m {rec['k_ms']:.1f}/{rec['m_ms']:.1f}ms" if rec.get("k_ms") and rec.get("m_ms") else ""
+        pk = f" pk{rec['peak'][0] / 1024:.1f}>{rec['peak'][1] / 1024:.1f}G" if rec.get("peak") else ""
+        return (f"on v{rec['variant']} {rec.get('layers', 0)}/{rec.get('of', 0)} min={rec['min_rows']} "
+                f"err={rec['err']:.1e} g={rec['gerr']:.0e} {rec.get('scratch_mb', 0)}MiB{km}{pk}{verdicts}")
+    if rec.get("status") != "ok":
+        return f"off {rec.get('reason', '-')}"
+    t = rec["times"]
+
+    def ratios(r):
+        return "/".join(_num(t[(r, "k", s)] / t[(r, "m", s)], ".2f") if t.get((r, "m", s)) else "-" for s in LARGE_ROWS)
+
+    return f"ok err={rec['err']:.1e} g={rec['gerr']:.0e} U {ratios('U')} C {ratios('C')} {rec.get('time_s', 0.0):.1f}s"
+
+
+def summary():
+    """This rank's load-time outcome for the scheduler's internal state (each value at most ``READOUT_MAX``
+    characters): ``mms_ratio``, ``mms_status``, ``mms_v<variant>``, ``msf_error`` (only on an error) and
+    ``msf_calls``, the kernel calls counted so far as <path><mode>=<calls>@<smallest M>-<largest M> (path d(ecode),
+    mode e(ager) / g(raph capture) / p(refill-graph capture)); ``moe_large`` with the large-batch kernel's load-time
+    outcome; ``attn_verify``. Empty when no flag is set."""
+    out, mm = {}, _STATE.get("mms")
+    if mm is not None:
+        out = mms_readout(mm)
+        if mm.get("error"):
+            out["msf_error"] = "mms: " + mm["error"]
+        out["msf_calls"] = " ".join(f"{p[0]}{md[0]}={n}@{lo}-{hi}"
+                                    for (p, md), (n, lo, hi) in sorted(_CALLS.items())) or "none"
+    if _CALLS and "msf_calls" not in out:  # kernel calls counted without the small kernel's record too
+        out["msf_calls"] = " ".join(f"{p[0]}{md[0]}={n}@{lo}-{hi}"
+                                    for (p, md), (n, lo, hi) in sorted(_CALLS.items()))
+    if "large" in _STATE:
+        out["moe_large"] = large_readout(_STATE["large"])
+    if "attn" in _STATE:
+        out["attn_verify"] = attn_readout(_STATE["attn"])
+    return {k: _clip(v) for k, v in out.items()}
+
+
+def summary_lines(limit=6):
+    """``summary`` as at most ``limit`` TELEM line bodies, for a caller that prints them again after startup."""
+    return [f"kind=summary name={k} {v}" for k, v in summary().items()][:limit]
+
+
+def marlin_layout():
+    """True when ``--muse-spark-kernel-moe-marlin-layout`` is set."""
+    from sglang.srt.runtime_context import get_exec
+
+    return bool(getattr(get_exec().moe, "muse_spark_kernel_moe_marlin_layout", False))
+
+
+def parse_table(text, variants):
+    """``--muse-spark-kernel-moe-marlin-layout-table``: "size:variant,..." (variant a number in ``variants`` or M for
+    Marlin) -> [(size, variant or None)] by size. Raises ValueError on anything else."""
+    table = {}
+    for item in text.replace(" ", "").split(","):
+        size, _, var = item.partition(":")
+        if not size.isdigit() or int(size) <= 0 or int(size) in table or var == "":
+            raise ValueError(f"table entry {item!r}")
+        if var.upper() == "M":
+            table[int(size)] = None
+        elif var.isdigit() and int(var) in variants:
+            table[int(size)] = int(var)
+        else:
+            raise ValueError(f"table variant {item!r} (variants {variants})")
+    if not table:
+        raise ValueError("empty table")
+    return sorted(table.items())
+
+
+def marlin_layout_table():
+    from sglang.srt.runtime_context import get_exec
+
+    return getattr(get_exec().moe, "muse_spark_kernel_moe_marlin_layout_table", None) or None
+
+
+def _mms_run(mod, st, x, ids, w, start, pre, variant):
+    if variant:
+        return mod.run(st, x, ids, w, start, pre_norm=pre, variant=variant)
+    return mod.run(st, x, ids, w, start, pre_norm=pre)
+
+
+def mms_forward(ex, x, topk_w, topk_ids, pre_expert_norm):
+    """The expert call: the large-batch kernel for calls of at least its minimum rows (when engaged), else the
+    Marlin-layout kernel (the variant the dispatch table picks for this row count); None when neither applies (stock
+    Marlin serves). The choice depends only on the row count."""
+    m = x.shape[0]
+    if "_msf_large" in ex.__dict__ and "mod" in _LARGE and m >= _LARGE["min_rows"]:
+        out = large_forward(ex, x, topk_w, topk_ids, pre_expert_norm)
+        if out is not None:
+            return out
+    if "_msf_mms" not in ex.__dict__:
+        return None
+    for bound, variant in _MMS_ROUTE:
+        if m <= bound:
+            if variant is not None:
+                count_call("decode", m)
+                return _mms_run(_STATE["mms_mod"], ex.__dict__["_msf_mms"], x, topk_ids, topk_w,
+                                ex.local_expert_offset, pre_expert_norm, variant)
+            break
+    return None
+
+
+def setup_marlin_layout(model):
+    """Set up the Marlin-layout kernel once, before CUDA-graph capture (see the module docstring). Any failure keeps
+    stock Marlin everywhere, agreed over ranks."""
+    if model.__dict__.get("_msf_mms_done") or not marlin_layout():
+        return
+    object.__setattr__(model, "_msf_mms_done", True)
+    from . import selftest
+
+    t0, mm = time.perf_counter(), {"sizes": MMS_ROWS}
+    _STATE["mms"] = mm
+    found, mod, table, why = None, None, None, None
+    try:
+        from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+        from . import moe_marlin_small as mod
+
+        cfg = model.config.text_config if hasattr(model.config, "text_config") else model.config
+        layers = model.model.language_model.layers
+        idx = [i for i, ly in enumerate(layers) if isinstance(getattr(ly.mlp, "experts", None), MuseSpark1xFp4Experts)]
+        if not idx:
+            raise ValueError("no NVFP4 experts")
+        if not all(getattr(layers[i].mlp.experts, "use_marlin", False) for i in idx):
+            raise ValueError("experts not on Marlin")
+        found = cfg, layers, idx
+        if marlin_layout_table():
+            table = parse_table(marlin_layout_table(), tuple(getattr(mod, "VARIANTS", (0,))))
+    except Exception as e:
+        why = selftest.why(e)
+    if not selftest.agree(why is None):
+        mm.update(status="off", reason="table" if why and "table" in why else "interface", error=why or "other rank",
+                  time_s=time.perf_counter() - t0)
+        telem("msf_mms", status="off", reason=mm["reason"], error=why or "other rank")
+        return
+    cfg, layers, idx = found
+    variants = tuple(getattr(mod, "VARIANTS", (0,)))
+    if table is not None:  # only the variants the table names, at every size it names
+        variants = tuple(v for v in variants if v in {var for _, var in table})
+        mm.update(sizes=tuple(s for s, _ in table), table=True)
+    sizes = tuple(sorted(set(MMS_ROWS) | set(mm["sizes"])))  # self-tested sizes (each class's upper bound included)
+    i0 = idx[0]
+    ex0, pre0 = layers[i0].mlp.experts, layers[i0].mlp.pre_expert_norm
+    dev, top_k, start = ex0.w13_weight.device, cfg.num_experts_per_tok, ex0.local_expert_offset
+    n_local, n_global, hidden = ex0.num_local_experts, ex0.global_num_experts, ex0.post_expert_norm.weight.shape[0]
+    mm.update(of=len(idx), tests={})
+
+    def marlin(x, w, ids):
+        return ex0._forward_marlin(x, w, ids, ex0.post_expert_norm, pre_expert_norm=pre0)
+
+    def kernel(v):
+        return lambda x, w, ids: _mms_run(mod, st0, x, ids, w, start, pre0, v)
+
+    st0, errs, why, vwhy = None, {v: float("inf") for v in variants}, None, {}
+    try:
+        mod.prepare(dev)
+        mm["scratch_mb"] = mod.scratch_bytes() // 2**20
+        st0 = mod.state(ex0)
+        rows = sizes[-1]
+        g = torch.Generator(device=dev).manual_seed(17)
+        x = torch.randn(rows, hidden, device=dev, generator=g).to(torch.bfloat16)
+        dense = (start + torch.rand(rows, min(2 * n_local, n_global), device=dev, generator=g).argsort(-1)[:, :top_k]) % n_global
+        uniform = torch.rand(rows, n_global, device=dev, generator=g).argsort(-1)[:, :top_k]
+        ids = torch.where((torch.arange(rows, device=dev) % 2 == 0)[:, None], dense, uniform)  # both routings
+        w = torch.rand(rows, top_k, device=dev, generator=g) + 0.1
+        w = w / w.sum(-1, keepdim=True)
+        full = marlin(x, w, ids)
+        mm["ref"] = selftest.rel(marlin(x[:8], w[:8], ids[:8]), full[:8])  # Marlin's own batch-size difference
+        refs = {s: marlin(x[:s], w[:s], ids[:s]) for s in sizes}
+        for v in variants:  # the first call of each variant happens here, outside any capture
+            try:  # a variant this device cannot run (e.g. too much shared memory) fails alone
+                errs[v] = max(selftest.rel(kernel(v)(x[:s], w[:s], ids[:s]), refs[s]) for s in sizes)
+            except Exception as e:
+                errs[v], vwhy[v] = float("inf"), selftest.why(e)
+                torch.cuda.synchronize()
+        del x, ids, w, full, dense, uniform, refs
+    except Exception as e:
+        why = selftest.why(e)
+        mm["error"] = why
+    passed = []
+    for v in variants:
+        w_ = why or vwhy.get(v)
+        ok = selftest.verdict("mms", errs[v], mm.get("ref", 0.0), variant=v, **({"why": w_} if w_ else {}))
+        gerr, gok = None, False
+        if ok:
+            gwhy = None
+            try:
+                gerr = selftest.graph(ex0, top_k, tuple(sorted(set(GRAPH_ROWS) | {sizes[-1]})), kernel(v))
+            except Exception as e:
+                gerr, gwhy = float("inf"), selftest.why(e)
+                mm["error"] = f"graph v{v}: {gwhy}"
+            gok = selftest.verdict("mms_graph", gerr, 0.0, variant=v, **({"why": gwhy} if gwhy else {}))
+        mm["tests"][v] = (ok, errs[v], gok, gerr)
+        if ok and gok:
+            passed.append(v)
+    if not passed:
+        mod._SCRATCH.clear()
+        torch.cuda.empty_cache()
+        mm.update(status="off", reason="selftest", time_s=time.perf_counter() - t0)
+        telem("msf_mms", status="off", reason="selftest")
+        return
+    kt, mt, use = {}, {}, {}
+    if table is not None:  # the fixed table; a class whose variant did not pass serves Marlin
+        use = {s: (v if v in passed else None) for s, v in table}
+    else:
+        kt = {v: {} for v in passed}
+        try:  # Marlin and each passing variant inside captured graphs, routing uniform over all experts
+            dims = (hidden, start, n_local, n_global, top_k, dev)
+            mt = selftest.probe(marlin, *dims, rows=MMS_ROWS)
+            for v in passed:
+                kt[v] = selftest.probe(kernel(v), *dims, rows=MMS_ROWS)
+        except Exception as e:
+            mm["error"] = f"probe: {selftest.why(e)}"
+        for s in MMS_ROWS:  # the same agreements, in the same order, on every rank
+            beat = [v for v in passed if selftest.agree(0 < kt[v].get(s, 0) < mt.get(s, 0))]
+            fast = [v for v in beat if selftest.agree(kt[v][s] <= min(kt[u][s] for u in beat))]
+            use[s] = (fast or beat or [None])[0]
+    mm.update(kernel=kt, marlin=mt, use=use)
+    used = sorted({v for v in use.values() if v is not None})
+    swapped, why = [], None
+    if used:
+        try:  # every layer: views of its Marlin tensors, one eager call per variant used at its smallest size
+            for i in idx:
+                ex = layers[i].mlp.experts
+                st = mod.state(ex)
+                for v in used:
+                    n = min(s for s in use if use[s] == v)
+                    xx = torch.randn(n, hidden, device=dev).to(torch.bfloat16)
+                    ii = torch.rand(n, n_global, device=dev).argsort(-1)[:, :top_k]
+                    ww = torch.full((n, top_k), 1.0 / top_k, device=dev)
+                    out = _mms_run(mod, st, xx, ii, ww, ex.local_expert_offset, layers[i].mlp.pre_expert_norm, v)
+                    if not bool(torch.isfinite(out).all()):
+                        raise RuntimeError(f"non-finite output on layer {i} (variant {v})")
+                swapped.append((ex, st))
+        except Exception as e:
+            why = selftest.why(e)
+    if used and selftest.agree(why is None):
+        _MMS_ROUTE[:] = sorted(use.items())
+        _STATE["mms_mod"] = mod
+        for ex, st in swapped:
+            object.__setattr__(ex, "_msf_mms", st)
+        mm.update(status="on", layers=len(swapped))
+    else:
+        swapped = []
+        mod._SCRATCH.clear()
+        mm.update(status="off", reason="slower" if not used else "layer_check", **({"error": why} if why else {}))
+    torch.cuda.empty_cache()
+    mm["time_s"] = time.perf_counter() - t0
+    telem("msf_mms", status=mm["status"], layers=len(swapped), of=len(idx), table=int(table is not None),
+          use="/".join(f"{s}:{'M' if use[s] is None else use[s]}" for s in sorted(use)), marlin_ms=_fmt_ms(mt),
+          **{f"v{v}_ms": _fmt_ms(kt[v]) for v in kt}, time_s=f"{mm['time_s']:.1f}", **memory())
+
+
+# The large-batch kernel (``moe_marlin_large``).
+LARGE_ROWS = (2048, 4096, 16384)  # sizes checked against Marlin and timed (the graph check uses the smallest)
+
+
+def conc_ids(m, n_global, top_k, dev, seed):
+    """Concentrated routing: requests of 8 consecutive tokens; expert popularity Zipf(s=1) over the ``n_global``
+    experts in a fixed random order (seed 123); each request draws a base set of ``top_k`` experts by popularity without
+    replacement, and each of its tokens keeps ``top_k - 2`` of it and draws 2 more from the rest (distinct per token).
+    Int64 [m, top_k] on ``dev``."""
+    order = torch.randperm(n_global, generator=torch.Generator().manual_seed(123))
+    pop = torch.zeros(n_global)
+    pop[order] = 1.0 / torch.arange(1, n_global + 1, dtype=torch.float32)
+    g = torch.Generator().manual_seed(seed)
+    base = torch.multinomial(pop.expand((m + 7) // 8, -1).contiguous(), top_k, replacement=False, generator=g)
+    base = base.repeat_interleave(8, 0)[:m]
+    keep = torch.gather(base, 1, torch.rand(m, top_k, generator=g).argsort(1)[:, :top_k - 2])
+    p = pop.expand(m, -1).clone()
+    p.scatter_(1, keep, 0.0)
+    extra = torch.multinomial(p, 2, replacement=False, generator=g)
+    return torch.cat([keep, extra], 1).to(dev)
+
+
+def _capture_mode():
+    try:
+        from sglang.srt.model_executor.runner_utils.capture_mode import get_is_capture_mode
+
+        return get_is_capture_mode()
+    except Exception:
+        return False
+
+
+# The large-batch kernel, engaged (``--muse-spark-kernel-moe-large``): expert calls of at least
+# ``--muse-spark-kernel-moe-large-min-rows`` rows run on ``moe_marlin_large`` (same Marlin tensors, no repack); smaller
+# calls are untouched. The variant (``--muse-spark-kernel-moe-large-variant``, default auto) is chosen at load: each
+# candidate is self-tested and graph-checked against live Marlin, agreed over ranks; the first that passes serves.
+# What each size exercises: 512 the default minimum; 640 / 641 straddle the two-CTA switch; 1000 odd mid-range; 2048 variant 0's
+# floor; 8191 an odd tail with partial 128-row tiles; 16384 the most rows per call.
+LARGE_CHECK_ROWS = (512, 640, 641, 1000, 2048, 8191, 16384)
+LARGE_GRAPH_ROWS = (512, 641, 2048, 16384)
+LARGE_VARIANT_MIN_ROWS = {0: 2048}  # variant 0 (mma.sync) is no faster than Marlin below 2048 rows: min rows clamped up
+_LARGE = {}  # "mod", "min_rows", "variant" once engaged
+
+
+def large_engage():
+    """(``--muse-spark-kernel-moe-large``, ``--muse-spark-kernel-moe-large-min-rows``,
+    ``--muse-spark-kernel-moe-large-variant``)."""
+    from sglang.srt.runtime_context import get_exec
+
+    moe = get_exec().moe
+    return (bool(getattr(moe, "muse_spark_kernel_moe_large", False)),
+            int(getattr(moe, "muse_spark_kernel_moe_large_min_rows", 2048) or 2048),
+            str(getattr(moe, "muse_spark_kernel_moe_large_variant", "auto") or "auto"))
+
+
+def large_candidates(variants, choice, capability):
+    """The variants to try, in order: ``choice`` "auto" = every variant of the module, the highest first (a variant
+    the device refuses fails its self-test alone and the next is tried); a number = that variant alone (if the module
+    has it). Raises ValueError."""
+    if choice == "auto":
+        return sorted(variants, reverse=True)
+    if not choice.isdigit() or int(choice) not in variants:
+        raise ValueError(f"variant {choice!r} not in {tuple(variants)}")
+    return [int(choice)]
+
+
+def _large_run(mod, st, x, ids, w, start, pre, variant):
+    if variant:
+        return mod.run(st, x, ids, w, start, pre_norm=pre, variant=variant)
+    return mod.run(st, x, ids, w, start, pre_norm=pre)
+
+
+def large_forward(ex, x, topk_w, topk_ids, pre_expert_norm):
+    """The expert call on the large-batch kernel, or None (stock Marlin serves). Never raises: an error in a Python-level
+    call (eager, or while a graph is captured) falls back to Marlin for this call and turns the kernel off for later
+    Python-level calls; graphs already captured with the kernel keep replaying it (validated at load)."""
+    try:
+        count_call("large", x.shape[0])
+        return _large_run(_LARGE["mod"], ex.__dict__["_msf_large"], x, topk_ids, topk_w, ex.local_expert_offset,
+                          pre_expert_norm, _LARGE["variant"])
+    except Exception as e:
+        _LARGE.pop("mod", None)
+        rec = _STATE.setdefault("large", {})
+        rec.update(status="off", reason=f"serving {type(e).__name__}:{str(e)[:60]}")
+        logger.warning("muse_spark_fused: large-batch kernel off after an error, Marlin serves: %s", e)
+        return None
+
+
+def setup_large(model):
+    """``--muse-spark-kernel-moe-large``, before CUDA-graph capture: on the first NVFP4 expert layer's real weights,
+    each candidate variant against live Marlin at ``LARGE_CHECK_ROWS`` (rows alternating uniform and concentrated
+    routing), then a graph check at ``LARGE_GRAPH_ROWS``, every verdict agreed over TP ranks; the first candidate that
+    passes both serves. Then every layer's views and one eager call (agreed). Any failure keeps Marlin everywhere.
+    Status: ``summary()['moe_large']``."""
+    on, min_rows, choice = large_engage()
+    if model.__dict__.get("_msf_large_done") or not on:
+        return
+    object.__setattr__(model, "_msf_large_done", True)
+    from . import selftest
+
+    rec, t0 = {"status": "off", "engage": True, "min_rows": min_rows, "verdicts": {}}, time.perf_counter()
+    _STATE["large"] = rec
+    peak0 = torch.cuda.max_memory_reserved()  # the process's reserved-memory peak so far (MiB in the TELEM line)
+    found, mod, cands, why = None, None, [], None
+    try:
+        from sglang.srt.layers.muse_spark.muse_spark_fp4_moe import MuseSpark1xFp4Experts
+
+        from . import moe_marlin_large as mod
+
+        cfg = model.config.text_config if hasattr(model.config, "text_config") else model.config
+        layers = model.model.language_model.layers
+        idx = [i for i, ly in enumerate(layers) if isinstance(getattr(ly.mlp, "experts", None), MuseSpark1xFp4Experts)]
+        if not idx:
+            raise ValueError("no NVFP4 experts")
+        if not all(getattr(layers[i].mlp.experts, "use_marlin", False) for i in idx):
+            raise ValueError("experts not on Marlin")
+        cands = large_candidates(tuple(getattr(mod, "VARIANTS", (0,))), choice, torch.cuda.get_device_capability())
+        if not cands:
+            raise ValueError("no variant for this device")
+        found = cfg, layers, idx
+    except Exception as e:
+        why = selftest.why(e)
+    if not selftest.agree(why is None):
+        rec.update(reason="interface " + (why or "other rank"), time_s=time.perf_counter() - t0)
+        telem("msf_large", status="off", reason=rec["reason"])
+        return
+    cfg, layers, idx = found
+    ex0, pre0 = layers[idx[0]].mlp.experts, layers[idx[0]].mlp.pre_expert_norm
+    dev, top_k, start = ex0.w13_weight.device, cfg.num_experts_per_tok, ex0.local_expert_offset
+    n_global, hidden = ex0.global_num_experts, ex0.post_expert_norm.weight.shape[0]
+    rec.update(of=len(idx), scratch_mb=mod.scratch_bytes(16384) // 2**20)
+
+    def marlin(x, w, ids):
+        return ex0._forward_marlin(x, w, ids, ex0.post_expert_norm, pre_expert_norm=pre0)
+
+    def kernel(v):
+        return lambda x, w, ids: _large_run(mod, st0, x, ids, w, start, pre0, v)
+
+    def inputs(m, seed):
+        g = torch.Generator(device=dev).manual_seed(seed)
+        x = torch.randn(m, hidden, device=dev, generator=g).to(torch.bfloat16)
+        uni = torch.rand(m, n_global, device=dev, generator=g).argsort(-1)[:, :top_k]
+        ids = torch.where((torch.arange(m, device=dev) % 2 == 0)[:, None], uni, conc_ids(m, n_global, top_k, dev, seed))
+        w = torch.rand(m, top_k, device=dev, generator=g) + 0.1
+        return x, w / w.sum(-1, keepdim=True), ids
+
+    st0, errs, ref, why, vwhy = None, {v: float("inf") for v in cands}, 0.0, None, {}
+    try:
+        mod.prepare(dev)
+        st0 = mod.state(ex0)
+        x, w, ids = inputs(LARGE_CHECK_ROWS[0], 51)
+        ref = selftest.rel(marlin(x[:8], w[:8], ids[:8]), marlin(x, w, ids)[:8])  # Marlin's own batch difference
+        errs = {v: 0.0 for v in cands}
+        for s in LARGE_CHECK_ROWS:  # one size at a time: the per-call caches are freed in between
+            x, w, ids = inputs(s, 53 + s)
+            ref_s = marlin(x, w, ids)
+            torch.cuda.empty_cache()  # Marlin's per-call caches go back before the kernel's are taken
+            for v in cands:
+                if v in vwhy:
+                    continue
+                try:  # a variant this device refuses (e.g. wgmma off SM 9.0) fails alone
+                    errs[v] = max(errs[v], selftest.rel(kernel(v)(x, w, ids), ref_s))
+                except Exception as e:
+                    errs[v], vwhy[v] = float("inf"), selftest.why(e)
+                torch.cuda.empty_cache()
+            del x, w, ids, ref_s
+            torch.cuda.empty_cache()
+    except Exception as e:
+        why = selftest.why(e)
+    rec["ref"], chosen, gerr = ref, None, None
+    for v in cands:  # the same verdicts, in the same order, on every rank
+        w_ = why or vwhy.get(v)
+        ok = selftest.verdict("mms", errs[v], ref, kernel=f"large_v{v}", **({"why": w_} if w_ else {}))
+        if ok:
+            gwhy = None
+            try:
+                gerr = selftest.graph(ex0, top_k, LARGE_GRAPH_ROWS, kernel(v))
+            except Exception as e:
+                gerr, gwhy = float("inf"), selftest.why(e)
+            torch.cuda.empty_cache()
+            ok = selftest.verdict("mms_graph", gerr, 0.0, kernel=f"large_v{v}", **({"why": gwhy} if gwhy else {}))
+            if not ok:
+                rec["verdicts"][v] = "graph"
+                why = why or gwhy
+        else:
+            rec["verdicts"][v] = "FAIL"
+        if ok:
+            rec["verdicts"][v], chosen = "ok", v
+            break
+    rec.update(err=errs.get(chosen, min(errs.values())), gerr=gerr, variant=chosen)
+    swapped = []
+    if chosen is not None:
+        why = None
+        try:  # every layer: views of its Marlin tensors, one eager call
+            for i in idx:
+                ex = layers[i].mlp.experts
+                st = mod.state(ex)
+                xx = torch.randn(1024, hidden, device=dev).to(torch.bfloat16)
+                ii = torch.rand(1024, n_global, device=dev).argsort(-1)[:, :top_k]
+                ww = torch.full((1024, top_k), 1.0 / top_k, device=dev)
+                out = _large_run(mod, st, xx, ii, ww, ex.local_expert_offset, layers[i].mlp.pre_expert_norm, chosen)
+                if not bool(torch.isfinite(out).all()):
+                    raise RuntimeError(f"non-finite output on layer {i}")
+                swapped.append((ex, st))
+        except Exception as e:
+            why = selftest.why(e)
+        if not selftest.agree(why is None):
+            rec["verdicts"][chosen], chosen = "layer", None
+    if chosen is not None:
+        try:  # for the record: both inside captured graphs at the largest size (uniform routing)
+            x, w, ids = inputs(LARGE_CHECK_ROWS[-1], 59)
+            rec["k_ms"] = selftest.graph_ms(lambda: kernel(chosen)(x, w, ids))
+            torch.cuda.empty_cache()
+            rec["m_ms"] = selftest.graph_ms(lambda: marlin(x, w, ids))
+            del x, w, ids
+        except Exception as e:
+            logger.warning("muse_spark_fused: large-batch timing skipped: %s", e)
+        min_rows = max(min_rows, LARGE_VARIANT_MIN_ROWS.get(chosen, 0))  # the effective start for this variant
+        _LARGE.update(mod=mod, min_rows=min_rows, variant=chosen)
+        for ex, st in swapped:
+            object.__setattr__(ex, "_msf_large", st)
+        rec.update(status="on", layers=len(swapped), variant=chosen, min_rows=min_rows)
+    else:
+        swapped = []
+        rec["reason"] = "selftest" + (" " + why if why else "")
+    st0 = None
+    torch.cuda.empty_cache()
+    rec["time_s"] = time.perf_counter() - t0
+    rec["peak"] = (peak0 >> 20, torch.cuda.max_memory_reserved() >> 20)  # MiB: the process's reserved peak around setup
+    telem("msf_large", status=rec["status"], reason=rec.get("reason", "-"), variant=rec.get("variant"),
+          verdicts="/".join(f"v{v}:{r}" for v, r in rec["verdicts"].items()) or "none", layers=len(swapped),
+          of=len(idx), err="/".join(f"v{v}:{e:.3g}" for v, e in errs.items()),
+          gerr=f"{gerr if gerr is not None else float('nan'):.3g}", min_rows=min_rows,
+          k_ms=f"{rec.get('k_ms', float('nan')):.3f}", m_ms=f"{rec.get('m_ms', float('nan')):.3f}",
+          peak_mb=f"{peak0 >> 20}->{torch.cuda.max_memory_reserved() >> 20}", time_s=f"{rec['time_s']:.1f}", **memory())
+
+
+# Attention at the verify shape (``--muse-spark-kernel-attn-verify``): the kernel module (``attn_verify``) replaces
+# norm -> rope -> KV store -> attention -> o-norm x gate for TARGET_VERIFY in MuseSpark1xAttention.forward (its adapter
+# asks ``attn_verify_on(attn)``). Here: the load-time self-test per layer type (sliding with RoPE, full without),
+# agreed over ranks, the per-layer-type switch, the workspace and the status. Any failure keeps that layer type on FA3.
+ATTN_BATCHES = (1, 4, 32)
+ATTN_CONTEXTS = (300, 2100, 9000)  # across the 2048 window and the kernel's split boundaries
+ATTN_VERIFY_TOKENS = 8
+ATTN_CANARY = 4096  # pool rows past the requests' slots that nothing may write
+ATTN_BOUND = 0.1  # relative L2 vs stock: both are 6-9% off FP32 truth on random data (FP8 noise x o-norm); gross errors 1-2
+ATTN_ROW_ABS = 2.0 ** -5  # a written element passes within one e4m3 code or this absolute distance of stock's
+# Peaked cases (``attn_peak_case``): exact-zero keys except one dominant key per query, so the softmax is one-hot on
+# both paths and the output is that key's (e4m3-exact) V through o-norm x gate, known in closed form. They check the
+# addressing the random cases' FP8 noise hides: the window edge, causality inside the 8 tokens, first/last positions,
+# split boundaries, SWA holes and the request index.
+ATTN_PEAK_CONTEXTS = (300, 2041, 2048, 2056, 9000)  # below, at and above the 2048-token window
+ATTN_PEAK_BOUND = 1e-2  # relative L2 vs stock and vs the closed form
+ATTN_PEAK_SPLITS = (256, 1024, 4096)  # a dominant key on each side of every multiple of these in range
+_ATTN = {}  # "on": {"sliding": bool, "full": bool}
+
+
+def attn_verify_flag():
+    """True when ``--muse-spark-kernel-attn-verify`` is set."""
+    from sglang.srt.runtime_context import get_exec
+
+    return bool(getattr(get_exec().moe, "muse_spark_kernel_attn_verify", False))
+
+
+def attn_kind(attn):
+    """"sliding" or "full" for a MuseSpark1xAttention (by its RadixAttention's window)."""
+    w = getattr(attn.attn, "sliding_window_size", None)  # as attn_verify._kind
+    return "sliding" if w is not None and w > 0 else "full"
+
+
+def attn_verify_on(attn):
+    """For the verify adapter: True only when the flag is set, setup passed and this layer's type passed."""
+    return bool(_ATTN.get("on", {}).get(attn_kind(attn)))
+
+
+def attn_contexts(attn, contexts):
+    """``contexts`` capped so every position (ctx + 8 tokens) is inside the layer's RoPE table (a short-context model
+    has fewer positions than the longest case), duplicates dropped."""
+    rope = getattr(attn, "rotary_emb", None)
+    limit = rope.cos_sin_cache.shape[0] - ATTN_VERIFY_TOKENS - 1 if rope is not None else None
+    out = []
+    for c in contexts:
+        c = c if limit is None else min(c, limit)
+        if c > 0 and c not in out:
+            out.append(c)
+    return tuple(out)
+
+
+def _e4m3_ordinal(t):
+    c = t.view(torch.uint8).to(torch.int16)
+    mag = c & 0x7F
+    return torch.where((c & 0x80) != 0, -mag, mag)
+
+
+def attn_case(attn, dev, batch, ctx, seed):
+    """One synthetic verify batch for ``attn``: an FP8 pool (random rows plus ``ATTN_CANARY`` canary rows at the end),
+    a page table that is a random permutation of slots, for sliding layers holes (slot of a canary row) outside the
+    window, the 8 new tokens' slots, seq_lens excluding them, positions and the raw qkv. Returns a dict."""
+    g = torch.Generator(device=dev).manual_seed(seed)
+    hq, hkv, d = attn.num_heads, attn.num_kv_heads, attn.head_dim
+    total = ctx + ATTN_VERIFY_TOKENS
+    used = batch * total
+    rows = used + ATTN_CANARY
+    k = (torch.randn(rows, hkv, d, device=dev, generator=g) * 0.5).to(torch.float8_e4m3fn)
+    v = (torch.randn(rows, hkv, d, device=dev, generator=g) * 0.5).to(torch.float8_e4m3fn)
+    perm = torch.randperm(used, device=dev, generator=g).to(torch.int32)
+    table = perm.view(batch, total).contiguous()
+    if attn_kind(attn) == "sliding":  # SWA pool: slots older than the window are freed; the table there is a hole
+        window = attn.attn.sliding_window_size + 1
+        old = torch.arange(total, device=dev) < (total - window - ATTN_VERIFY_TOKENS)
+        table = torch.where(old[None, :], torch.full_like(table, used), table)  # a canary row: must never be read
+    cache_loc = table[:, ctx:].reshape(-1).contiguous()
+    seq_lens = torch.full((batch,), ctx, dtype=torch.int32, device=dev)
+    positions = (ctx + torch.arange(ATTN_VERIFY_TOKENS, device=dev)).repeat(batch)
+    qkv = torch.randn(batch * ATTN_VERIFY_TOKENS, 2 * attn.q_size + 2 * attn.kv_size, device=dev,
+                      generator=g).to(torch.bfloat16)
+    one = torch.ones(1, device=dev, dtype=torch.float32)
+    return dict(k=k, v=v, table=table, cache_loc=cache_loc, seq_lens=seq_lens, positions=positions, qkv=qkv,
+                k_scale=one, v_scale=one, used=used)
+
+
+def attn_peak_case(attn, dev, batch, ctx, seed):
+    """A verify batch whose softmax is one-hot for every query, plus its closed-form output (``want``). Query token i
+    is one RoPE pair P_i (raw q 1.0 there, so 8 after the weightless norm); keys are exact zeros except, on that pair,
+    c times the direction of query i after norm + RoPE (logit about 5.5c): c = 8 for the expected key, c = 16 for a key
+    that must stay invisible. Per query the expected key is at the oldest in-window position (sliding; with a c = 16
+    key one step further out), at 0, at ctx-1 or beside a split boundary; one query per request instead tests the
+    block: expected = verify token i-1 (raw k on P_i and a spare pair: logit about 31), invisible = token i+1 (all on
+    P_i: about 44). SWA holes point at a canary row holding a c = 16 key for every query. V and the new tokens' v are
+    exact in e4m3 and bf16; the gate is random. Positions, V and gates differ per request."""
+    g = torch.Generator(device=dev).manual_seed(seed)
+    hq, hkv, d = attn.num_heads, attn.num_kv_heads, attn.head_dim
+    w8, qs, kvs = ATTN_VERIFY_TOKENS, attn.q_size, attn.kv_size
+    total, sliding = ctx + w8, attn_kind(attn) == "sliding"
+    used = batch * total
+    left = attn.attn.sliding_window_size if sliding else None  # keys p-left .. p are visible to position p
+
+    def grid(*shape):  # +-0.25 .. 2.0 in steps of 0.25: exact in e4m3 and bf16, never 0
+        mag = torch.randint(1, 9, shape, device=dev, generator=g).float() * 0.25
+        return mag * (torch.randint(0, 2, shape, device=dev, generator=g).float() * 2 - 1)
+
+    k = torch.zeros(used + ATTN_CANARY, hkv, d, device=dev)
+    v = grid(used + ATTN_CANARY, hkv, d)
+    table = torch.randperm(used, device=dev, generator=g).to(torch.int32).view(batch, total).contiguous()
+    if sliding:
+        old = torch.arange(total, device=dev) < (total - left - 1 - w8)
+        table = torch.where(old[None, :], torch.full_like(table, used), table)
+    pairs, spare = [d // 4 + i * max(1, d // 32) for i in range(w8)], d // 2 - 1
+    raw = torch.zeros(batch * w8, 2 * qs + 2 * kvs, device=dev)
+    for i, p in enumerate(pairs):
+        raw[i::w8, :qs].view(-1, hq, d)[:, :, 2 * p] = 1.0
+    qkv0 = raw[:w8].to(torch.bfloat16)
+    pos0 = ctx + torch.arange(w8, device=dev)
+    if attn.rotary_emb is not None:  # q exactly as the stock path computes it (one per token: same in every request)
+        qr, _ = attn._fused_qk_norm(qkv0, pos0, attn.rotary_emb.cos_sin_cache, kv_store=None)
+    else:
+        qr, _ = attn._fused_qk_norm(qkv0, kv_store=None)
+    qr = qr.float().reshape(w8, hq, d)[:, 0]
+    unit = [qr[i, 2 * p:2 * p + 2] / qr[i, 2 * p:2 * p + 2].norm() for i, p in enumerate(pairs)]
+    kraw = raw[:, qs:qs + kvs].view(-1, hkv, d)
+    vraw = raw[:, qs + kvs:qs + 2 * kvs].view(-1, hkv, d)
+    vraw.copy_(grid(batch * w8, hkv, d))
+    raw[:, qs + 2 * kvs:] = torch.randn(batch * w8, qs, device=dev, generator=g)
+    exp_v = torch.empty(batch * w8, hkv, d, device=dev)
+
+    def put(slot, i, c):
+        k[slot, :, 2 * pairs[i]:2 * pairs[i] + 2] = c * unit[i]
+
+    for i in range(w8):  # holes: reading one flips the output
+        put(used, i, 16.0)
+    for b in range(batch):
+        iv = (b + seed) % w8  # this request's block-causality query
+        for i in range(w8):
+            t, p = b * w8 + i, ctx + i
+            if i == iv:
+                if i == 0:
+                    slot = int(table[b, ctx - 1])
+                    put(slot, 0, 5.5)
+                    exp_v[t] = v[slot]
+                else:
+                    kraw[t - 1, :, 2 * pairs[i]] = 1.0
+                    kraw[t - 1, :, 2 * spare] = 1.0
+                    exp_v[t] = vraw[t - 1]
+                if i + 1 < w8:
+                    kraw[t + 1, :, 2 * pairs[i]] = 1.0
+                continue
+            lo = max(0, p - left) if sliding else 0
+            cands = [lo, ctx - 1] + ([0] if lo == 0 else [])
+            for s in ATTN_PEAK_SPLITS:
+                m = (lo // s + 1) * s
+                if m <= ctx - 1:
+                    cands += [m - 1, m]
+            a = cands[(b * w8 + i + seed) % len(cands)]
+            if sliding and a == lo and lo > 0:
+                put(int(table[b, lo - 1]), i, 16.0)
+            slot = int(table[b, a])
+            put(slot, i, 8.0)
+            exp_v[t] = v[slot]
+    qkv = raw.to(torch.bfloat16)
+    gate = qkv[:, qs + 2 * kvs:].float().view(-1, hq, d)
+    o = exp_v.repeat_interleave(hq // hkv, dim=1)
+    eps = float(getattr(attn, "norm_eps", 1e-6))
+    want = (o * torch.rsqrt(o.pow(2).mean(-1, keepdim=True) + eps) * torch.sigmoid(gate)).reshape(-1, qs)
+    one = torch.ones(1, device=dev, dtype=torch.float32)
+    return dict(k=k.to(torch.float8_e4m3fn), v=v.to(torch.float8_e4m3fn), table=table,
+                cache_loc=table[:, ctx:].reshape(-1).contiguous(),
+                seq_lens=torch.full((batch,), ctx, dtype=torch.int32, device=dev),
+                positions=pos0.repeat(batch), qkv=qkv, k_scale=one, v_scale=one, used=used, want=want)
+
+
+def attn_check(mod, attn, case):
+    """Stock path and kernel on separate copies of one case. Returns (relative L2 of the outputs, largest e4m3 code
+    distance on the written rows, written elements beyond one code and beyond ``ATTN_ROW_ABS`` of stock's (stock's BF16
+    staging rounds small RoPE'd values less accurately), rows outside the written slots that changed, finite, and for
+    a peaked case the kernel's and stock's relative L2 to the closed form, else 0)."""
+    from . import selftest
+
+    def run(fn):
+        k, v = case["k"].clone(), case["v"].clone()
+        out = fn(attn, case["qkv"], case["positions"], case["seq_lens"], case["cache_loc"], case["table"], k, v,
+                 case["k_scale"], case["v_scale"])
+        return out, k, v
+
+    so, sk, sv = run(mod.stock_verify)
+    ko, kk, kv = run(mod.kernel_verify)
+    err = selftest.rel(ko, so)
+    loc = case["cache_loc"].long()
+    ulp, bad = 0, 0
+    for a, b in ((kk, sk), (kv, sv)):
+        dist = (_e4m3_ordinal(a[loc]) - _e4m3_ordinal(b[loc])).abs()
+        far = (a[loc].float() - b[loc].float()).abs() > ATTN_ROW_ABS
+        ulp, bad = max(ulp, int(dist.max())), bad + int(((dist > 1) & far).sum())
+    keep = torch.ones(case["k"].shape[0], dtype=torch.bool, device=loc.device)
+    keep[loc] = False
+    touched = int(sum(((x[keep].view(torch.uint8) != y[keep].view(torch.uint8)).flatten(1).any(1)).sum()
+                      for x, y in ((kk, case["k"]), (kv, case["v"]))))
+    want = case.get("want")
+    cerr, serr = (0.0, 0.0) if want is None else (selftest.rel(ko, want), selftest.rel(so, want))
+    return err, ulp, bad, touched, bool(torch.isfinite(ko.float()).all()), cerr, serr
+
+
+def attn_graph_check(mod, attn, case):
+    """The kernel captured in a throwaway CUDA graph and replayed, against an eager call on a fresh copy: relative L2
+    of the outputs and whether the written rows are equal."""
+    from . import selftest
+
+    dev = case["qkv"].device
+    k1, v1 = case["k"].clone(), case["v"].clone()
+    args = (attn, case["qkv"], case["positions"], case["seq_lens"], case["cache_loc"], case["table"])
+    side = selftest.side_stream(dev)
+    side.wait_stream(torch.cuda.current_stream(dev))
+    with torch.cuda.stream(side):
+        mod.kernel_verify(*args, k1.clone(), v1.clone(), case["k_scale"], case["v_scale"])
+    torch.cuda.current_stream(dev).wait_stream(side)
+    cg = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(cg):
+        out = mod.kernel_verify(*args, k1, v1, case["k_scale"], case["v_scale"])
+    k1.copy_(case["k"])
+    v1.copy_(case["v"])
+    cg.replay()
+    k2, v2 = case["k"].clone(), case["v"].clone()
+    ref = mod.kernel_verify(*args, k2, v2, case["k_scale"], case["v_scale"])
+    torch.cuda.synchronize()
+    same = bool(torch.equal(k1.view(torch.uint8), k2.view(torch.uint8)) and torch.equal(v1.view(torch.uint8), v2.view(torch.uint8)))
+    err = selftest.rel(out, ref)
+    del cg
+    return err, same
+
+
+def setup_attn_verify(model):
+    """``--muse-spark-kernel-attn-verify``, before CUDA-graph capture: per layer type (the first sliding and the first
+    full attention layer), the kernel against the stock path on synthetic verify batches (B in ``ATTN_BATCHES`` x
+    context in ``ATTN_CONTEXTS``): finite, relative L2 under ``ATTN_BOUND``, written rows within one e4m3 step, no
+    other row changed; peaked batches (``attn_peak_case``, contexts ``ATTN_PEAK_CONTEXTS``) within ``ATTN_PEAK_BOUND``
+    of stock and of the closed form; then a graph capture and replay against eager. Every verdict agreed over TP
+    ranks; a failure keeps that layer type on FA3. Never raises. Status: ``summary()['attn_verify']``."""
+    if model.__dict__.get("_msf_attn_done") or not attn_verify_flag():
+        return
+    object.__setattr__(model, "_msf_attn_done", True)
+    from . import selftest as st
+
+    rec, t0 = {"status": "off", "kinds": {}}, time.perf_counter()
+    _STATE["attn"] = rec
+    mod, attns, why = None, {}, None
+    try:
+        from . import attn_verify as mod
+
+        layers = model.model.language_model.layers
+        dev = next(model.parameters()).device
+        ok, why0 = mod.supported(dev)
+        if not ok:
+            raise RuntimeError(why0)
+        for ly in layers:
+            a = getattr(ly, "self_attn", None)
+            if a is not None and hasattr(a, "attn") and attn_kind(a) not in attns:
+                attns[attn_kind(a)] = a
+        if not attns:
+            raise ValueError("no attention layers")
+        rec["ws_mb"] = mod.prepare(dev, max(ATTN_BATCHES))
+    except Exception as e:
+        why = st.why(e)
+    if not st.agree(why is None):
+        rec.update(reason=why or "other rank", time_s=time.perf_counter() - t0)
+        telem("msf_attn", status="off", reason=rec["reason"])
+        return
+    on, serve = {}, tuple(getattr(mod, "SERVE_KINDS", ("sliding", "full")))
+    for kind in ("sliding", "full"):  # the same agreements, in the same order, on every rank
+        if kind not in serve:  # the module keeps this layer type on stock by design: not tested, never served
+            on[kind] = False
+            rec["kinds"][kind] = dict(ok=False, design=True, err=0.0, perr=0.0, serr=0.0, ulp=0, bad=0, touched=0,
+                                      gerr=0.0, why=None)
+            continue
+        a, err, ulp, bad, touched, gerr, same, why = attns.get(kind), 0.0, 0, 0, 0, 0.0, True, None
+        perr, serr = 0.0, 0.0
+        try:
+            if a is None:
+                raise ValueError("no layer of this type")
+            for bi, b in enumerate(ATTN_BATCHES):
+                for ci, c in enumerate(attn_contexts(a, ATTN_CONTEXTS)):
+                    case = attn_case(a, dev, b, c, 1000 * bi + ci)
+                    e, u, bd, tch, fin, _, _ = attn_check(mod, a, case)
+                    err, ulp, bad, touched = max(err, e if fin else float("inf")), max(ulp, u), bad + bd, touched + tch
+                    del case
+                for ci, c in enumerate(attn_contexts(a, ATTN_PEAK_CONTEXTS)):
+                    case = attn_peak_case(a, dev, b, c, 100 + 10 * bi + ci)
+                    e, u, bd, tch, fin, ce, se = attn_check(mod, a, case)
+                    perr = max(perr, max(e, ce) if fin else float("inf"))
+                    serr, ulp, bad, touched = max(serr, se), max(ulp, u), bad + bd, touched + tch
+                    del case
+            case = attn_case(a, dev, ATTN_BATCHES[1], attn_contexts(a, ATTN_CONTEXTS[1:2])[0], 7)
+            gerr, same = attn_graph_check(mod, a, case)
+            del case
+            torch.cuda.empty_cache()
+        except Exception as e:
+            err, perr, why = float("inf"), float("inf"), st.why(e)
+        local = (err <= ATTN_BOUND and perr <= ATTN_PEAK_BOUND and bad == 0 and touched == 0 and gerr <= 1e-2
+                 and same)
+        on[kind] = st.agree(local)
+        rec["kinds"][kind] = dict(ok=on[kind], err=err, perr=perr, serr=serr, ulp=ulp, bad=bad, touched=touched,
+                                  gerr=gerr, why=why)
+    _ATTN["on"] = on
+    rec.update(status="on" if any(on.values()) else "off", time_s=time.perf_counter() - t0)
+    if not any(on.values()):
+        rec["reason"] = "selftest"
+    torch.cuda.empty_cache()
+    telem("msf_attn", status=rec["status"], **{f"{k}_ok": int(v["ok"]) for k, v in rec["kinds"].items()},
+          **{f"{k}_design_off": int(bool(v.get("design"))) for k, v in rec["kinds"].items()},
+          **{f"{k}_err": f"{v['err']:.3g}" for k, v in rec["kinds"].items()},
+          **{f"{k}_peak": f"{v['perr']:.3g}" for k, v in rec["kinds"].items()},
+          **{f"{k}_stock_closed": f"{v['serr']:.3g}" for k, v in rec["kinds"].items()},
+          **{f"{k}_why": (v["why"] or "-")[:80] for k, v in rec["kinds"].items()},
+          ws_mb=rec.get("ws_mb", 0), time_s=f"{rec['time_s']:.1f}", **memory())
+
+
+def attn_readout(rec):
+    """One value: ``on|off sliding=ok|FAIL|off-by-design full=ok|FAIL|off-by-design err=s:<rel L2>/f:<rel L2>
+    pk=s:<peaked>/f:<peaked> ulp=<max> ws=<MiB> <setup s>`` (err and pk for the tested types only; FAIL = the
+    self-test failed, off-by-design = the module does not serve that type) or ``off <reason>``."""
+    k = rec.get("kinds", {})
+    if not k:
+        return f"off {rec.get('reason', '-')}"
+    names = [n for n in ("sliding", "full") if n in k]
+    tested = [n for n in names if not k[n].get("design")]
+    v = f"{rec['status']} " + " ".join(
+        f"{n}={'off-by-design' if k[n].get('design') else 'ok' if k[n]['ok'] else 'FAIL'}" for n in names)
+    if tested:
+        v += " err=" + "/".join(f"{n[0]}:{k[n]['err']:.1e}" for n in tested)
+        v += " pk=" + "/".join(f"{n[0]}:{k[n].get('perr', 0.0):.1e}" for n in tested)
+    v += f" ulp={max([k[n]['ulp'] for n in tested] or [0])}"
+    canary, bad = sum(x.get("touched", 0) for x in k.values()), sum(x.get("bad", 0) for x in k.values())
+    v += (f" bad={bad}" if bad else "") + (f" canary={canary}" if canary else "") + f" ws={rec.get('ws_mb', 0)}MiB {rec.get('time_s', 0.0):.1f}s"
+    bad = [x["why"] for x in k.values() if x.get("why")]
+    return v + (f" {bad[0]}" if bad else "")
