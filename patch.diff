+CPP_SRC = r"""
+void run(torch::Tensor qkv, torch::Tensor seq_lens, torch::Tensor cache_loc, torch::Tensor k_cache,
+         torch::Tensor v_cache, torch::Tensor page_table, torch::Tensor k_scale, torch::Tensor v_scale,
+         torch::Tensor inv_freq, torch::Tensor out, torch::Tensor ws_acc, torch::Tensor ws_l,
+         torch::Tensor ws_cnt, int64_t B, int64_t L, int64_t Hq, int64_t Hkv, int64_t P, int64_t window,
+         int64_t rope, int64_t n_splits, int64_t flat, int64_t nc, double scale_log2, int64_t tma);
+"""
+
+_MOD = None
+_INV_FREQ = {}
+_WS = {}
+_NUM_SMS = {}
+
+
+def _cached(cache, key, make):
+    value = cache.get(key)
+    if value is None:
+        value = make()
+        cache[key] = value
+    return value
+
+
+def available():
+    """True when the kernel can be built here (Hopper, sm_90)."""
+    return torch.cuda.is_available() and torch.cuda.get_device_capability() == (9, 0)
+
+
+def _build():
+    from torch.utils.cpp_extension import load_inline
+
+    cap = torch.cuda.get_device_capability()
+    if cap != (9, 0):
+        raise RuntimeError("muse_attention_decode needs sm_90a (Hopper); this device is sm_%d%d" % cap)
+    return load_inline(
+        name="msf_attn_decode_q8_90a",
+        cpp_sources=CPP_SRC,
+        cuda_sources=CUDA_SRC,
+        functions=["run"],
+        extra_cuda_cflags=["-O3", "-gencode=arch=compute_90a,code=sm_90a", "--expt-relaxed-constexpr"],
+        verbose=False,
+    )
+
+
+def _module():
+    global _MOD
+    if _MOD is None:
+        _MOD = _build()
+    return _MOD
+
+
+def _inv_freq(theta, device, n_pairs=HEAD_DIM // 2):
+    """RoPE inverse frequencies, 1 / theta^(2i / head_dim), one per pair."""
+
+    def make():
+        if theta:
+            t = 1.0 / (theta ** (torch.arange(0, 2 * n_pairs, 2, device=device).float() / (2 * n_pairs)))
+        else:
+            t = torch.zeros(n_pairs, device=device)
+        return t.float().contiguous()
+
+    return _cached(_INV_FREQ, (float(theta), str(device), n_pairs), make)
+
+
+def _workspace(n_rows, device):
+    """Persistent FP32 accumulators (zero between calls: the last CTA resets them). Grows only; allocate at the
+    largest size before graph capture."""
+    key = str(device)
+    ws = _WS.get(key)
+    if ws is None or ws[0].numel() < n_rows * HEAD_DIM:
+        n = max(n_rows, WORKSPACE_MIN_ROWS)
+        ws = (torch.zeros(n * HEAD_DIM, dtype=torch.float32, device=device),
+              torch.zeros(n, dtype=torch.float32, device=device),
+              torch.zeros(n, dtype=torch.int32, device=device))
+        _WS[key] = ws
+    return ws
+
+
+def _num_sms(device):
+    return _cached(_NUM_SMS, str(device), lambda: torch.cuda.get_device_properties(device).multi_processor_count)
+
+
+def _splits(tiles, quota):
+    """Splits per (request, KV pair): at least 1, at most one per tile."""
+    return max(1, min(tiles, quota))
+
+
+def _copies(n, cap):
+    """Workspace copies: at least 1, at most cap."""
+    return max(1, min(n, cap))
+
+
+def _headroom(target):
+    return (target * PLAN_HEADROOM_NUM) // PLAN_HEADROOM_DEN
+
+
+def _plan(B, pairs, L, window, max_pages, P, device):
+    """Launch plan for a shape: n_splits CTAs per (request, KV pair) or, flat, per KV pair over all requests; nc
+    workspace copies; coop (cooperative finalize) when the plan sets it."""
+    sms = _num_sms(device)
+    target = 2 * sms
+    if not window and 1 < B <= MAX_BATCH:
+        return dict(n_splits=max(1, target // pairs), flat=1, nc=1)
+    keys_max = min(window + L - 1, max_pages * P) if window else max_pages * P
+    tiles = max(1, (keys_max + TILE_KEYS - 1) // TILE_KEYS)
+    reqs = B * pairs
+    if not window:
+        n = _splits(tiles, _headroom(target) // reqs)
+        return dict(n_splits=n, flat=0, nc=_copies(n, 8))
+    if reqs < 16:
+        return dict(n_splits=_splits(tiles, target // reqs), flat=0, nc=1, coop=1)
+    # many requests: about one CTA per SM once the requests alone fill the GPU
+    return dict(n_splits=_splits(tiles, sms // reqs), flat=0, nc=1, coop=1)
+
+
+def _launch(data, pdl=None, **override):
+    cfg = data["config"]
+    B, L = cfg["batch"], cfg["q_len"]
+    hq, hkv, d, P = cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"], cfg["page_size"]
+    qkv = data["qkv"]
+    device = qkv.device
+    pairs = hkv // 2
+    window = cfg["window"]
+    page_table = data["page_table"]
+    out = torch.empty((B, L, hq * d), dtype=torch.bfloat16, device=device)
+    plan = _plan(B, pairs, L, window, page_table.shape[1], P, device)
+    if override:
+        plan = dict(plan, **override)
+        if "n_splits" in override and "nc" not in override:
+            plan["nc"] = 1 if plan["flat"] else _copies(plan["n_splits"], 4)
+    n_splits, flat, nc = plan["n_splits"], plan["flat"], plan["nc"]
+    # Cooperative finalize only for grids that are all resident (the launch re-checks residency and falls back).
+    if flat:
+        coop = int(plan.get("coop", int(n_splits * pairs <= 2 * _num_sms(device))))
+    else:
+        coop = int(plan.get("coop", 0 if n_splits < 64 else int(n_splits * B * pairs <= 2 * _num_sms(device))))
+    tma = int(plan.get("tma", 0)) | (coop << COOP_BIT) | (int(bool(pdl)) << PDL_BIT)
+    ws_acc, ws_l, ws_cnt = _workspace(B * pairs * nc * L * Q_HEADS_PER_PAIR, device)
+    scale_log2 = cfg["sm_scale"] * cfg["qk_scale_factor"] * LOG2E
+    _module().run(qkv, data["seq_lens"], data["cache_loc"], data["k_cache"], data["v_cache"], page_table,
+                  data["k_scale"], data["v_scale"], _inv_freq(cfg["rope_theta"], device), out, ws_acc, ws_l,
+                  ws_cnt, B, L, hq, hkv, P, window, 1 if cfg["rope_theta"] else 0, n_splits, flat, nc, scale_log2,
+                  tma)
+    return out
+
+
+def _supported(cfg):
+    P = cfg["page_size"]
+    return (cfg["head_dim"] == HEAD_DIM and cfg["num_q_heads"] == 8 * cfg["num_kv_heads"]
+            and cfg["num_kv_heads"] % 2 == 0 and cfg["q_len"] == Q_LEN and cfg["batch"] <= MAX_BATCH
+            and P > 0 and (P & (P - 1)) == 0 and cfg["batch"] * (cfg["num_kv_heads"] // 2) <= MAX_REQUEST_PAIRS)
+
+
+def _fits(data):
+    """Sizes the kernel's 32-bit indexing covers (caches of any size are fine: 64-bit offsets past 4 GB)."""
+    cfg = data["config"]
+    out_elems = cfg["batch"] * cfg["q_len"] * cfg["num_q_heads"] * cfg["head_dim"]
+    return (data["qkv"].numel() < INDEX_LIMIT and data["page_table"].numel() < INDEX_LIMIT
+            and out_elems < INDEX_LIMIT)
+
+
+def kernel_fn(data):
+    if not (_supported(data["config"]) and _fits(data)):
+        raise ValueError("muse_attention_decode: unsupported shape (q_len 8, head_dim 64 only)")
+    return _launch(data)
