+# SPDX-License-Identifier: Apache-2.0
+"""Muse Spark target-verify attention on one fused kernel (``--muse-spark-kernel-attn-verify``, off by default).
+
+Per verify step and attention layer, the kernel (``attn_decode``: vjeux/okc-2026 f35a41e, Apache-2.0) does what the
+stock path does in several launches: Q/K RMS norm, RoPE (layers with a rope theta), the FP8 store of the step's K/V,
+attention over the paged FP8 cache (the SWA pool on sliding layers) and o-norm * sigmoid(gate). Its output feeds
+o_proj. Where it serves it owns the KV write of the step's tokens (the stock store is skipped, not repeated): FP32 ->
+e4m3 (stock: FP32 -> BF16 -> e4m3), the same slots as stock (out_cache_loc, or the backend's full->SWA translated
+swa_out_cache_loc on sliding layers).
+
+``weights.setup_attn_verify`` (before CUDA-graph capture) checks ``kernel_verify`` against ``stock_verify`` per layer
+type and keeps the switch (``weights.attn_verify_on``); ``run`` serves only TARGET_VERIFY batches of the fixed width 8
+on the FA3 backend with an FP8 e4m3 cache and untranslated page tables; anything else runs the stock path.
+Workspace: one per process, allocated by ``prepare`` before capture, zero between calls (the kernel's last CTA resets
+it); layers run one at a time on one stream, which is all the shared workspace assumes.
+"""
+import torch
+
+WIDTH = 8  # verify tokens per request (DFlash, --speculative-num-draft-tokens 8)
+COOP = 0  # cooperative finalize off on every launch: its grid barrier is the kernel's only wait loop / trap site
+SERVE_KINDS = ("sliding", "full")  # both layer types (checked on Hopper with CUDA graphs)
+_MOD = None
+_ONE = {}  # device -> fp32 [1] ones (a layer without a KV scale)
+
+
+def kernel():
+    """The kernel module (``attn_decode``), built on first use."""
+    global _MOD
+    if _MOD is None:
+        from . import attn_decode
+
+        attn_decode._module()
+        _MOD = attn_decode
+    return _MOD
+
+
+def supported(device):
+    """(ok, reason) for the device, without building: the kernel is sm_90a only."""
+    if torch.cuda.get_device_capability(device) != (9, 0):
+        return False, "not sm_90a"
+    return True, ""
+
+
+def prepare(device, max_batch=32):
+    """Outside capture: build the kernel and allocate the workspace for up to ``max_batch`` requests. Returns MiB."""
+    mod = kernel()
+    dev = torch.device(device)
+    rows = max(mod.WORKSPACE_MIN_ROWS, max_batch * 2 * 8 * WIDTH * mod.Q_HEADS_PER_PAIR)  # 2 pairs, 8 copies
+    ws = mod._workspace(rows, dev)
+    mod._num_sms(dev)
+    _ONE[str(dev)] = torch.ones(1, dtype=torch.float32, device=dev)
+    return sum(t.numel() * t.element_size() for t in ws) >> 20
+
+
+def _kind(attn):
+    w = attn.attn.sliding_window_size
+    return "sliding" if w is not None and w > 0 else "full"
+
+
+def kernel_verify(attn, qkv, positions, seq_lens, cache_loc, page_table, k_cache, v_cache, k_scale, v_scale):
+    """The fused kernel for one verify batch of ``attn`` (a MuseSpark1xAttention): bf16 [B * 8, Hq * D], the input of
+    o_proj. Writes the step's K/V rows at ``cache_loc``. ``k_cache`` / ``v_cache``: [rows, Hkv, D] e4m3 (page size
+    1); ``page_table``: [B, >= seq + 8] int32; ``seq_lens``: prefix lengths (without the 8); ``positions`` unused (the
+    kernel derives them from ``seq_lens``)."""
+    mod = kernel()
+    B = page_table.shape[0]
+    win = attn.attn.sliding_window_size + 1 if _kind(attn) == "sliding" else 0
+    theta = float(attn.rotary_emb.base) if attn.rotary_emb is not None else 0.0
+    cfg = dict(batch=B, q_len=WIDTH, num_q_heads=attn.num_heads, num_kv_heads=attn.num_kv_heads,
+               head_dim=attn.head_dim, page_size=1, window=win, rope_theta=theta,
+               qk_scale_factor=attn.scale_query_by, sm_scale=attn.head_dim ** -0.5, kv_scale=1.0)
+    data = dict(qkv=qkv, seq_lens=seq_lens if seq_lens.dtype == torch.int32 else seq_lens.to(torch.int32),
+                cache_loc=cache_loc if cache_loc.dtype == torch.int64 else cache_loc.long(),
+                k_cache=k_cache, v_cache=v_cache,
+                page_table=page_table if page_table.dtype == torch.int32 else page_table.to(torch.int32),
+                k_scale=k_scale, v_scale=v_scale, config=cfg)
+    over = {"coop": COOP}  # the plan's own split; the cooperative finalize stays off
+    assert over["coop"] == 0, "attn_verify launches never set the cooperative bit"
+    return mod._launch(data, **over).view(B * WIDTH, attn.q_size)
+
+
+def stock_verify(attn, qkv, positions, seq_lens, cache_loc, page_table, k_cache, v_cache, k_scale, v_scale):
+    """The stock path for the same batch, with the FA3 backend's target-verify arguments: the layer's fused QK norm +
+    RoPE, set_kv_buffer's store (divide by the layer's KV scale when it has one, cast to e4m3), flash_attn_with_kvcache
+    (q in e4m3, cache_seqlens = seq + 8, causal, window (sliding_window_size, 0), num_splits 0, descales when the
+    layer has KV scales), then the layer's fused o-norm * gate."""
+    from sglang.kernels.ops.attention.flash_attention import flash_attn_with_kvcache
+
+    a, B = attn.attn, page_table.shape[0]
+    T, hq, hkv, d = B * WIDTH, attn.num_heads, attn.num_kv_heads, attn.head_dim
+    o_gate = qkv[:, attn.q_size + 2 * attn.kv_size:]
+    v = qkv[:, attn.q_size + attn.kv_size:attn.q_size + 2 * attn.kv_size]
+    if attn.rotary_emb is not None:
+        q, k = attn._fused_qk_norm(qkv, positions, attn.rotary_emb.cos_sin_cache, kv_store=None)
+    else:
+        q, k = attn._fused_qk_norm(qkv, kv_store=None)
+    k, v = k.reshape(T, hkv, d), v.reshape(T, hkv, d)
+    loc = cache_loc.long()
+    if a.k_scale is not None:
+        k, v = k / k_scale, v / v_scale
+    k_cache[loc] = k.to(k_cache.dtype)
+    v_cache[loc] = v.to(v_cache.dtype)
+    kw = {}
+    if a.k_scale is not None:
+        kw = dict(k_descale=k_scale.expand(B, hkv), v_descale=v_scale.expand(B, hkv))
+    cache_seqlens = seq_lens.to(torch.int32) + WIDTH
+    cu_q = torch.arange(0, (B + 1) * WIDTH, WIDTH, dtype=torch.int32, device=qkv.device)
+    cu_k = torch.nn.functional.pad(torch.cumsum(cache_seqlens, 0, dtype=torch.int32), (1, 0))
+    sliding = _kind(attn) == "sliding"
+    out = flash_attn_with_kvcache(q=q.reshape(T, hq, d).to(k_cache.dtype), k_cache=k_cache.view(-1, 1, hkv, d),
+                                  v_cache=v_cache.view(-1, 1, hkv, d), page_table=page_table.to(torch.int32),
+                                  cache_seqlens=cache_seqlens, cu_seqlens_q=cu_q, cu_seqlens_k_new=cu_k,
+                                  max_seqlen_q=WIDTH, softmax_scale=a.scaling, causal=True,
+                                  window_size=(a.sliding_window_size, 0) if sliding else (-1, -1),
+                                  softcap=a.logit_cap, num_splits=0, ver=3, **kw)
+    out = out[0] if isinstance(out, tuple) else out
+    return attn._fused_o_norm_gate(out.reshape(T, attn.q_size), o_gate)
+
+
+def _servable(fb, backend):
+    """Host-side checks, constant for a captured graph: the batch is a fixed-width verify the kernel covers."""
+    from sglang.srt.layers.attention.flashattention_backend import FlashAttentionBackend
+    from sglang.srt.layers.cp.utils import is_cp_active
+    from sglang.srt.runtime_context import get_memory
+
+    if not isinstance(backend, FlashAttentionBackend) or backend.fa_impl_ver != 3 or backend.page_size != 1:
+        return False
+    if backend.kv_cache_dtype != torch.float8_e4m3fn or backend.kv_cache_is_mxfp8 or backend.use_mla:
+        return False
+    if (backend.topk or 0) > 1 or backend.speculative_num_draft_tokens != WIDTH or backend.fa_skip_kv_cache:
+        return False
+    if backend.kv_index_translator.is_translating or backend._kv_shard_pool is not None:
+        return False
+    if getattr(backend, "attention_chunk_size", None) is not None or get_memory().enable_unified_memory:
+        return False
+    if getattr(fb.spec_info, "ragged_verify_layout", None) is not None or fb.encoder_lens is not None:
+        return False
+    if is_cp_active(fb) or fb.dcp_kv_mask is not None:
+        return False
+    md = backend.forward_metadata
+    return md is not None and md.swa_spec_metadata is None
+
+
+def _guard(fb, table, rows):
+    """(seq_lens int32, page table clamped to [0, rows)) for ``table``, once per forward and table (shared by every
+    layer that reads it). Clamp: the kernel forms K/V addresses from table entries itself (FA3's TMA tolerates
+    out-of-range coordinates), so no entry it can read may leave the pool; a clamped stray entry reads a wrong row
+    instead of faulting. Only entries outside every real request's read range can be stray (padding rows, slots
+    past seq + 8, evicted SWA slots): a real request reads its own live slots. seq 0 for a row whose newest prefix
+    entry is out of range (CUDA-graph padding rows: seq_lens 1, req_pool_index 0, a stale row that translates to -1
+    on the SWA pool) or whose seq + 8 exceeds the table.
+    The memo is keyed by capture state as well: SGLang runs the same ForwardBatch twice eagerly (warm-up) and then
+    under capture, and a warm-up tensor reused by the capture would be read by every replay after it is freed."""
+    memo = getattr(fb, "_msf_guard", None)
+    if memo is None:
+        memo = fb._msf_guard = {}
+    key = (table.data_ptr(), torch.cuda.is_current_stream_capturing())
+    g = memo.get(key)
+    if g is None:
+        s = fb.seq_lens if fb.seq_lens.dtype == torch.int32 else fb.seq_lens.to(torch.int32)
+        width = table.shape[1]
+        last = table.gather(1, (s.long() - 1).clamp(0, width - 1)[:, None])[:, 0]
+        bad = (s > 0) & ((last < 0) | (last >= rows) | (s + WIDTH > width))
+        s = torch.where(bad, torch.zeros_like(s), s)
+        g = memo[key] = (s, table.clamp(0, rows - 1))
+    return g
+
+
+def _scale(s, dev):
+    if isinstance(s, torch.Tensor) and s.dtype == torch.float32 and s.numel() == 1:
+        return s
+    return _ONE[str(dev)] if s is None else None
+
+
+def run(m, qkv, fb):
+    """The layer's o_proj input for a servable TARGET_VERIFY batch ([tokens, q_size]), else None (stock path). The
+    caller has checked ``weights.attn_verify_on(m)``."""
+    from sglang.srt.model_executor.forward_context import get_attn_backend
+
+    backend = get_attn_backend()
+    B = fb.batch_size
+    if qkv.shape[0] != B * WIDTH or not qkv.is_contiguous() or not _servable(fb, backend):
+        return None
+    a, md, pool = m.attn, backend.forward_metadata, backend.token_to_kv_pool
+    if _kind(m) not in SERVE_KINDS:
+        return None
+    if _kind(m) == "sliding" and backend.use_sliding_window_kv_pool:
+        loc, table = md.swa_out_cache_loc, md.swa_page_table
+        if table is None:
+            table = pool.translate_loc_from_full_to_swa(md.page_table).to(torch.int32)
+    else:
+        loc, table = fb.out_cache_loc, md.page_table
+    if loc is None or table is None or loc.dtype != torch.int64 or table.dtype != torch.int32:
+        return None
+    kc, vc = pool.get_kv_buffer(a.layer_id)
+    row = m.num_kv_heads * m.head_dim
+    if kc.stride(0) != row or vc.stride(0) != row or not (kc.is_contiguous() and vc.is_contiguous()):
+        return None
+    ks, vs = _scale(a.k_scale, qkv.device), _scale(a.v_scale, qkv.device)
+    if ks is None or vs is None or kc.element_size() != 1 or vc.element_size() != 1:  # e4m3 (or its uint8 store)
+        return None
+    seq, table = _guard(fb, table, kc.shape[0])
+    return kernel_verify(m, qkv, None, seq, loc, table, kc, vc, ks, vs)
