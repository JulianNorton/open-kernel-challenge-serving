index 0000000..645e3a6
--- /dev/null
+++ b/python/sglang/kernels/ops/muse_spark_fused/selftest.py
@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Load-time checks and timing for the Marlin-layout expert kernel (see ``weights.setup_marlin_layout``).
+
+* ``verdict``: pass iff ``err <= max(ABS[path], 3 * ref)``, where ``ref`` is Marlin's own batch-composition variation
+  and ``ABS`` a gross-error bound (wrong addressing, rank slice or scale give errors of 0.1-1). Every verdict is the
+  minimum over TP ranks, so all ranks switch together.
+* ``graph``: the expert call captured in a throwaway CUDA graph, replayed on fresh inputs, against eager.
+* ``probe``: one expert path timed inside captured CUDA graphs (median of ``PROBE_REPS`` replays).
+"""
+import torch
+
+ABS = {"mms": 2e-2, "mms_graph": 1e-2}
+PROBE_REPS = 10
+
+
+def why(e):
+    return f"{type(e).__name__}:{str(e)[:120]}"
+
+
+def rel(a, b):
+    """Relative L2 error of ``a`` against ``b``."""
+    return float((a.float() - b.float()).norm() / b.float().norm().clamp(min=1e-12))
+
+
+def agree(ok):
+    """True iff ``ok`` holds on every TP rank."""
+    from sglang.srt.distributed import get_tp_group
+
+    t, g = torch.tensor([1.0 if ok else 0.0], device="cuda"), get_tp_group()
+    if g.world_size > 1:
+        torch.distributed.all_reduce(t, op=torch.distributed.ReduceOp.MIN, group=g.device_group)
+    return bool(t.item() > 0.5)
+
+
+def verdict(path, err, ref, **kv):
+    """Agreed pass/fail for one check, with one TELEM line."""
+    from .weights import telem
+
+    bound = max(ABS[path], 3 * ref)
+    ok = agree(err <= bound)
+    telem("selftest", path=path, status="ok" if ok else "fallback", err=f"{err:.3g}", ref=f"{ref:.3g}",
+          bound=f"{bound:.3g}", **kv)
+    return ok
+
+
+_SIDE = {}
+
+
+def side_stream(dev):
+    """One side stream per device for every throwaway capture: each new stream would keep its own library workspaces
+    for the life of the process."""
+    if dev not in _SIDE:
+        _SIDE[dev] = torch.cuda.Stream(device=dev)
+    return _SIDE[dev]
+
+
+def graph(ex, top_k, rows, run):
+    """For each M in ``rows``: capture ``run(x, w, ids)`` in a throwaway CUDA graph, replay it on fresh inputs and
+    compare with an eager call on the same inputs. Returns the worst relative error; capture or replay errors
+    propagate."""
+    dev, hidden, start, n_global = ex.post_expert_norm.weight.device, ex.post_expert_norm.weight.shape[0], \
+        ex.local_expert_offset, ex.global_num_experts
+    g, worst = torch.Generator(device=dev).manual_seed(13), 0.0
+
+    def inputs(m):
+        x = torch.randn(m, hidden, device=dev, generator=g).to(torch.bfloat16)
+        pool = min(2 * ex.num_local_experts, n_global)
+        ids = ((start + torch.rand(m, pool, device=dev, generator=g).argsort(-1)[:, :top_k]) % n_global).to(torch.int32)
+        w = torch.rand(m, top_k, device=dev, generator=g) + 0.1
+        return x, ids, w / w.sum(-1, keepdim=True)
+
+    for m in rows:
+        x, ids, w = inputs(m)
+        side = side_stream(dev)
+        side.wait_stream(torch.cuda.current_stream(dev))
+        with torch.cuda.stream(side):  # warm-up off the capture, as torch.cuda.graph expects
+            run(x, w, ids)
+        torch.cuda.current_stream(dev).wait_stream(side)
+        cg = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(cg):
+            out = run(x, w, ids)
+        x2, ids2, w2 = inputs(m)
+        x.copy_(x2)
+        ids.copy_(ids2)
+        w.copy_(w2)
+        cg.replay()
+        worst = max(worst, rel(out, run(x2, w2, ids2)))
+        del cg, out
+    return worst
+
+
+def graph_ms(fn, reps=PROBE_REPS):
+    """Median CUDA-event time of one replay of ``fn`` captured in a throwaway CUDA graph (load time only)."""
+    dev = torch.cuda.current_device()
+    side = side_stream(dev)
+    side.wait_stream(torch.cuda.current_stream(dev))
+    with torch.cuda.stream(side):  # the run before capture that torch.cuda.graph expects
+        fn()
+    torch.cuda.current_stream(dev).wait_stream(side)
+    cg = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(cg):
+        fn()
+    cg.replay()
+    times = []
+    for _ in range(reps):
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        cg.replay()
+        b.record()
+        b.synchronize()
+        times.append(a.elapsed_time(b))
+    del cg
+    return sorted(times)[len(times) // 2]
+
+
+def probe(run, hidden, start, n_local, n_global, top_k, dev, rows):
+    """Time ``run(x, w, ids)`` (one expert path) at every ``rows`` size inside a captured graph, on the same seeded
+    inputs for every path, with routing uniform over all ``n_global`` experts as expert parallelism sees it (about
+    top_k * n_local / n_global local routes per token; only local experts are computed). Returns {M: ms}."""
+    out = {}
+    for m in rows:
+        g = torch.Generator(device=dev).manual_seed(29 + m)
+        x = torch.randn(m, hidden, device=dev, generator=g).to(torch.bfloat16)
+        ids = torch.rand(m, n_global, device=dev, generator=g).argsort(-1)[:, :top_k]
+        w = torch.rand(m, top_k, device=dev, generator=g) + 0.1
+        w = w / w.sum(-1, keepdim=True)
+        out[m] = graph_ms(lambda: run(x, w, ids))
+        del x, ids, w
+    torch.cuda.empty_cache()
+    return out
