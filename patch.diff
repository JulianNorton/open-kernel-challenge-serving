+# Portions Copyright vjeux, from https://github.com/vjeux/okc-2026 (commit f35a41e), licensed under the Apache
+# License 2.0.
+# Submitted by alygg77 under the Apache License 2.0 with this notice retained.
+# Stripped to the serving shape (q_len 8, head_dim 64, sm_90a) for speculative-decoding verification: the q_len 1
+# builds, the speculative-length builds (MODE | 8), cluster mode, the PyTorch fallback and the debug / profiling hooks
+# of the original were removed; the remaining kernel instantiations compile to the original's SASS (see the README of
+# the strip) except the flat kernel, which ptxas re-allocates.
+"""Gated attention decode, q_len 8: one fused CUDA kernel per call.
+
+    O = rmsnorm(softmax(Q K^T * sm_scale) V) * sigmoid(gate)
+
+Q / K are RMS-normalized (Q also scaled by qk_scale_factor), RoPE is applied on sliding-window layers, K / V are
+quantized to FP8 (E4M3) in the cache. QK^T is an FP8 wgmma (queries rounded to E4M3, as FA3's FP8 path does), PV an FP8
+wgmma (P in E4M3), with an online softmax.
+
+* One CTA per (request, pair of KV heads, split-KV split); a "pair" is two KV heads = 16 query heads.
+* Each CTA builds the block's new K / V (normalized, RoPE, FP8), writes them to the cache and streams its key range
+  through shared memory in 64-key tiles. The kernel owns the cache write of the new tokens.
+* Splits merge with FP32 atomics into a workspace (rescaled to a fixed reference); the last CTA of a (request, KV pair)
+  finalizes (rmsnorm * sigmoid(gate)) and zeroes the workspace. With `coop` set (grid known resident) every CTA instead
+  waits for all splits through an epoch-tagged counter and finalizes a slice of the rows.
+* Launch modes (MODE template parameter): 1 plain split-KV, 3 cooperative finalize, |4 = every split holds at most one
+  tile; the flat kernel (full layers, several requests) is one CTA pass over all requests' keys, with a grid-wide
+  cooperative finalize when resident. _plan() picks the shape, launch() (CUDA) the instantiation.
+* CUDA-graph capturable: no host syncs; the workspace is allocated once, at the largest size, before capture, and is
+  zero between calls. One call at a time per process (the counters in the workspace are not reentrant).
+"""
+
+import torch
+
+HEAD_DIM = 64
+Q_LEN = 8
+Q_HEADS_PER_PAIR = 16
+MAX_BATCH = 512
+MAX_REQUEST_PAIRS = 4096
+TILE_KEYS = 64
+INDEX_LIMIT = 1 << 31
+WORKSPACE_MIN_ROWS = 1 << 15
+LOG2E = 1.4426950408889634
+COOP_BIT = 1
+PDL_BIT = 16
+PLAN_HEADROOM_NUM = 21
+PLAN_HEADROOM_DEN = 22
+
+CUDA_SRC = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <type_traits>
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <cuda.h>
+#include <stdint.h>
+// Waits: every spin is thread 0 polling an acquire load, bounded by SPIN_CHECK (2^24 polls, then __trap). A wait is
+// only entered when the host has checked that the whole grid is resident (launch(): occupancy, else coop = 0).
+// The workspace (p.ws_acc / ws_l / ws_cnt) is zero between calls: the last CTA to finalize resets what it read.
+namespace {
+__device__ __noinline__ void spin_fail() {
+  __trap();
+}
+#define SPIN_T0 unsigned _spin_n = 0
+#define SPIN_CHECK                                                                                                     \
+  do {                                                                                                                 \
+    if (++_spin_n > (1u << 24)) spin_fail();                                                                           \
+  } while (0)
+template <int L, bool F>
+struct Cfg {
+  static constexpr int NT = 256;
+  static constexpr bool WS = F;
+  static constexpr int NP = WS ? 128 : 0;
+  static constexpr int NTX = NT + NP;
+  static constexpr int MINB = 2;
+  static constexpr int PREGS() {
+    return 32;
+  }
+  static constexpr int CREGS() {
+    constexpr int base = (65536 / (2 * NTX)) / 8 * 8 > 255 ? 248 : (65536 / (2 * NTX)) / 8 * 8;
+    constexpr int c = ((base * NTX - 32 * NP) / (NT > 0 ? NT : 1)) / 8 * 8;
+    return c > 248 ? 248 : c;
+  }
+  static constexpr int STAGES = F ? 4 : 3;
+  static_assert(!WS || (NP % 8 == 0 && NP >= 8 && 64 % (NP >= 8 ? NP / 8 : 1) == 0),
+                "producer threads must cover a tile in whole passes");
+};
