diff --git a/python/sglang/srt/layers/muse_spark/muse_spark_proj_gather.py b/python/sglang/srt/layers/muse_spark/muse_spark_proj_gather.py
new file mode 100644
index 0000000..2e346c7
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_proj_gather.py
@@ -0,0 +1,127 @@
+"""Column-parallel pre/post-expert projections with a multicast all-gather at small token counts (Muse Spark).
+
+The replicated projections around the experts (``pre_expert_proj``, 8192 -> 4096, and ``post_expert_proj``,
+4096 -> 8192) read their full BF16 weight on every TP rank. ``gemm_ag`` (layers/communication/muse_spark_gemm_ag.py)
+instead multiplies this rank's contiguous ``N / TP`` row block of the weight and multicast-gathers the column slices,
+so each rank reads 1/TP of the weight. Stock SGLang takes that path for the post-expert projection at up to
+``SMALL_PROJECTION_MAX_TOKENS`` (8) tokens wherever the custom all-reduce has a multicast mapping, and for the
+pre-expert projection only on SM 10.3. Two options widen it:
+
+* ``--enable-moe-pre-proj-gather``: the pre-expert projection takes the same path, wherever ``gemm_ag_supported``
+  holds (it needs a CustomAllReduceV2 multicast mapping; ``multimem`` stores need SM90+).
+* ``--moe-proj-gather-max-tokens N``: the token count up to which both projections take it (default 8, stock). It is
+  kept below ``--moe-proj-shard-min-tokens`` when that is set, so a batch takes at most one of the two sharded paths.
+
+The rows, the weights and the GEMM dispatcher are the same; only the N extent of each GEMM call changes (a slice of
+the weight instead of all of it) and the result is gathered, not reduced. The dispatcher may pick a different kernel
+for the slice shape, so the result is checked at load against the replicated GEMM on real weights on every rank
+(``selfcheck``), agreed over the TP group, with the options reverting to stock on any failure. The decision depends only
+on the token count, static options and that agreed verdict, so all ranks issue the same collectives.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+import torch.distributed as dist
+
+from sglang.kernels.ops.communication.muse_spark_all_gather import (
+    MAX_TOKENS,
+    SMALL_PROJECTION_MAX_TOKENS,
+)
+from sglang.srt.runtime_context import get_parallel
+
+logger = logging.getLogger(__name__)
+
+# Relative error allowed against the replicated GEMM: only the GEMM's N extent changes, so a correct slice agrees to
+# BF16 rounding (or exactly); a wrong row block or a stale gather gives errors of order 1.
+SELFCHECK_TOL = 1e-2
+
+_STATE = {"status": "stock", "pre_proj_gather": False, "max_tokens": SMALL_PROJECTION_MAX_TOKENS}
+
+
+def summary() -> dict:
+    """The load-time outcome: status (stock / on / off), the reason, the effective options and the check's results."""
+    return dict(_STATE)
+
+
+def pre_proj_gather() -> bool:
+    """Whether the pre-expert projection takes the gather path (agreed at load; False until then)."""
+    return _STATE["pre_proj_gather"]
+
+
+def max_tokens() -> int:
+    """Largest token count for the gather path (agreed at load; stock's 8 until then)."""
+    return _STATE["max_tokens"]
+
+
+def _rel(a: torch.Tensor, b: torch.Tensor) -> float:
+    return float((a.float() - b.float()).norm() / b.float().norm().clamp(min=1e-12))
+
+
+def selfcheck(moe_layers, enable_pre: bool, want_max_tokens: int, shard_min_tokens: int) -> None:
+    """Check the gather path of both projections of the first MoE layer against the replicated GEMM at the smallest
+    and largest token counts it will take, once at load (before CUDA-graph capture), and switch the options on only if
+    every TP rank passes. Phase 1 (references) is local; phase 2 runs the gathers in the same order on every rank.
+    Each phase is agreed over the TP group's CPU group, and any exception counts as a failure."""
+    from sglang.kernels.ops.communication.muse_spark_all_gather import gemm_ag_supported
+    from sglang.srt.layers.communication.muse_spark_gemm_ag import gemm_ag
+    from sglang.srt.layers.quantization.unquant import bf16_gemm_dispatch
+
+    limit = min(int(want_max_tokens), MAX_TOKENS)
+    if shard_min_tokens > 0:
+        limit = min(limit, shard_min_tokens - 1)  # never overlap the token-sharded path
+    limit = max(limit, SMALL_PROJECTION_MAX_TOKENS)
+    if not enable_pre and limit == SMALL_PROJECTION_MAX_TOKENS:
+        _STATE.update(status="stock", reason="options at their defaults")
+        return
+    parallel = get_parallel()
+    moe = next((m for m in moe_layers if getattr(m, "pre_expert_proj", None) is not None
+                and getattr(m, "post_expert_proj", None) is not None), None)
+    if parallel.tp_size <= 1 or parallel.moe_tp_size != 1 or moe is None:
+        _STATE.update(status="off", reason="needs pure tensor parallelism and replicated projections")
+        return
+    group = parallel.tp_group
+    comm = group.ca_comm
+
+    def agree(ok: bool) -> bool:
+        flag = torch.tensor([1 if ok else 0], dtype=torch.int32)
+        dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group.cpu_group)
+        return bool(flag.item())
+
+    w_pre, w_post = moe.pre_expert_proj.weight, moe.post_expert_proj.weight
+    sizes = sorted({1, SMALL_PROJECTION_MAX_TOKENS, limit})
+    # The pre-expert projection gathers only with the option on; the post-expert one already does at <= 8 tokens.
+    cases = [(w_pre, m) for m in sizes if enable_pre] + [(w_post, m) for m in sizes if m > SMALL_PROJECTION_MAX_TOKENS]
+    err, bitwise, why = float("inf"), False, None
+    try:  # phase 1: support and references, local work only
+        g = torch.Generator(device=w_pre.device).manual_seed(1234)  # the same replicated inputs on every rank
+        inputs = [(w, torch.randn((m, w.shape[1]), generator=g, device=w.device).to(w.dtype)) for w, m in cases]
+        ok = all(gemm_ag_supported(comm, x, w, small_max_tokens=limit) for w, x in inputs)
+        if not ok:
+            why = "gemm_ag not supported here (needs CustomAllReduceV2 with a multicast mapping and push capacity)"
+        refs = [bf16_gemm_dispatch(x, w, None) for w, x in inputs] if ok else []
+    except Exception as e:  # noqa: BLE001 - any failure keeps stock
+        ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+    if agree(ok):
+        try:  # phase 2: the gathers, in the same order on every rank
+            got = [gemm_ag(comm, x, w) for w, x in inputs]
+            err = max(_rel(a, b) for a, b in zip(got, refs))
+            bitwise = all(torch.equal(a, b) for a, b in zip(got, refs))
+            ok = err <= SELFCHECK_TOL  # False for NaN too
+            if not ok:
+                why = f"relative error {err:.2e} above {SELFCHECK_TOL}"
+        except Exception as e:  # noqa: BLE001
+            ok, why = False, f"{type(e).__name__}: {str(e)[:160]}"
+        ok = agree(ok)
+    else:
+        ok = False
+    if ok:
+        _STATE.update(status="on", reason="selfcheck passed", pre_proj_gather=bool(enable_pre), max_tokens=limit)
+    else:
+        _STATE.update(status="off", reason=why or "failed on another rank", pre_proj_gather=False,
+                      max_tokens=SMALL_PROJECTION_MAX_TOKENS)
+    _STATE.update(err=f"{err:.2e}", bitwise=bitwise, checked=",".join(str(m) for m in sizes))
+    torch.cuda.empty_cache()
+    (logger.info if ok else logger.warning)("Muse Spark projection gather: %s", _STATE)
